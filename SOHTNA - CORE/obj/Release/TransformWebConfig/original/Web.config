    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" executionTimeout="300" maxRequestLength="51200" />
    <pages>
      <namespaces>
      </namespaces>
      <controls>
      </controls>
    </pages>
    <authentication mode="None" />
    <!-- Show detailed errors while debugging -->
    <customErrors mode="Off" defaultRedirect="Login.aspx" />
  </system.web>

