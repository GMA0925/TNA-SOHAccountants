  <appSettings>
    
    <!-- Email Configuration for Error Reporting -->
    <!-- IMPORTANT: Configure these settings before deploying to production -->
    <!-- SmtpServer: Your SMTP server address (e.g., mail.domain.com, smtp.gmail.com, etc.) -->
    <add key="SmtpServer" value="mail.epiqtechsa.co.za" />
    <!-- SmtpPort: Use 587 for TLS (STARTTLS). NOTE: .NET SmtpClient does NOT support implicit SSL on port 465 -->
    <add key="SmtpPort" value="587" />
    <!-- SenderEmail: Email address to send from (must be authorized on the SMTP server) -->
    <add key="SenderEmail" value="sales@epiqtechsa.co.za" />
    <!-- SenderPassword: SMTP password (store securely - consider using environment variables in production) -->
    <add key="SenderPassword" value="0925Greg@#!!!" />
    <!-- ErrorReportEmail: Email address to receive error reports -->
    <add key="ErrorReportEmail" value="sales@epiqtechsa.co.za" />
    <!-- EnableEmailNotifications: Set to 'true' to enable email notifications, 'false' to disable -->
    <add key="EnableEmailNotifications" value="true" />
  </appSettings>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
    </handlers>
    <!-- Force login.aspx as the default document -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="login.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>

  <system.web>
    <httpHandlers>
