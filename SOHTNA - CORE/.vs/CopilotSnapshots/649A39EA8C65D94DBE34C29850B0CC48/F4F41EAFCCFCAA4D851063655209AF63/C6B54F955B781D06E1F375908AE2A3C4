        private void ClearEntryForm()
        {
            if (ddlEntryDate.Items.Count > 0)
                ddlEntryDate.SelectedIndex = 0;
            if (ddlProject.Items.Count > 0)
                ddlProject.SelectedIndex = 0;
            txtTask.Text = "";
            txtHours.Text = "";
            chkBillable.Checked = true;
        }

