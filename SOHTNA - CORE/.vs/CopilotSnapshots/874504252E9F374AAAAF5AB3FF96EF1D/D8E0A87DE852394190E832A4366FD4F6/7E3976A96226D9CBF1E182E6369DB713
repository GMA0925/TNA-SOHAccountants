                case "Hourly": return "Hourly Distribution Report";
                case "TopUsers": return "Top Users Report";
                case "Missing": return "Missing Names Report";
                case "Rollup": return "Site Rollup Report";
                default: return "Report";
            }
        }

        private string FormatColumnHeader(string columnName)
        {
            if (string.IsNullOrEmpty(columnName)) return "";
            // Insert spaces before uppercase letters for camelCase/PascalCase names
            var sb = new System.Text.StringBuilder();
            foreach (char c in columnName)
            {
                if (char.IsUpper(c) && sb.Length > 0)
                    sb.Append(' ');
                sb.Append(c);
            }
            return sb.ToString();
        }

        private int ParseTimeSpentToMinutes(string timeSpent)
        {
            int totalMinutes = 0;
            if (string.IsNullOrEmpty(timeSpent)) return 0;
            try
            {
                // Parse "Xh Ym" format
                string[] parts = timeSpent.Replace("h", "").Replace("m", "").Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length >= 1)
                {
                    int hours;
                    if (int.TryParse(parts[0], out hours))
                        totalMinutes += hours * 60;
                }
                if (parts.Length >= 2)
                {
                    int mins;
                    if (int.TryParse(parts[1], out mins))
                        totalMinutes += mins;
                }
            }
            catch { }
            return totalMinutes;
        }

