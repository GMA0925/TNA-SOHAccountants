        // ClosedXML Helper: Write Data Table
        // ============================

        private void WriteXlDataTable(IXLWorksheet ws, int startRow, DataTable dt, string reportType, System.Collections.Generic.HashSet<string> excludeCols)
        {
            int endRow;
            WriteXlDataTableCore(ws, startRow, dt, reportType, excludeCols, out endRow);
        }

        private void WriteXlDataTableCore(IXLWorksheet ws, int startRow, DataTable dt, string reportType, System.Collections.Generic.HashSet<string> excludeCols, out int lastDataRow)
        {
            var displayCols = new System.Collections.Generic.List<DataColumn>();
            foreach (DataColumn col in dt.Columns)
                if (!excludeCols.Contains(col.ColumnName))
                    displayCols.Add(col);

            int row = startRow;

            // Column headers — center aligned
            for (int c = 0; c < displayCols.Count; c++)
            {
                var cell = ws.Cell(row, c + 1);
                cell.Value = FormatColumnHeader(displayCols[c].ColumnName);
                cell.Style.Font.Bold = true;
                cell.Style.Fill.BackgroundColor = XLColor.FromHtml("#0078D4");
                cell.Style.Font.FontColor = XLColor.White;
                cell.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            }
            row++;

            // Data rows
            bool alt = false;
            foreach (DataRow dr in dt.Rows)
            {
                bool hasShift = dt.Columns.Contains("HasShift") && dr["HasShift"] != DBNull.Value && Convert.ToInt32(dr["HasShift"]) == 1;
                bool isStillInside = dt.Columns.Contains("Status") && dr["Status"]?.ToString() == "Still Inside";

                for (int c = 0; c < displayCols.Count; c++)
                {
                    var col = displayCols[c];
                    var cell = ws.Cell(row, c + 1);
                    object val = dr[col];

                    // Center align all data cells
                    cell.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;

                    // Shift-aware overrides must be checked before the DBNull/type branches
                    // because the underlying DB value may be NULL when no shift is assigned.
                    if ((col.ColumnName == "ShiftStartTime" || col.ColumnName == "ShiftEndTime") && !hasShift)
                    {
                        cell.Value = "No shift assigned";
                        cell.Style.Font.FontColor = XLColor.FromHtml("#CC6600");
                    }
                    else if (col.ColumnName == "Variance" && !hasShift)
                    {
                        cell.Value = "N/A";
                        cell.Style.Font.FontColor = XLColor.Gray;
                    }
                    else if (col.ColumnName == "RequiredHours" && !hasShift)
                    {
                        cell.Value = "Still to be set";
                        cell.Style.Font.FontColor = XLColor.FromHtml("#CC6600");
                    }
                    else if (val == DBNull.Value || val == null)
                    {
                        cell.Value = string.Empty;
                    }
                    else if (col.DataType == typeof(DateTime))
                    {
                        DateTime dtVal = (DateTime)val;
                        cell.Value = dtVal;
                        cell.Style.DateFormat.Format = col.ColumnName.Contains("Date") || col.ColumnName == "WorkDate"
                            ? "yyyy-MM-dd"
                            : "HH:mm:ss";
                    }
                    else if (col.DataType == typeof(decimal) || col.DataType == typeof(double))
                    {
                        if ((col.ColumnName == "Earnings" || col.ColumnName == "BasicPay") && isStillInside)
                        {
                            cell.Value = string.Empty;
                        }
                        else
                        {
                            cell.Value = Convert.ToDouble(val);
                            cell.Style.NumberFormat.Format = col.ColumnName == "BasicPay" || col.ColumnName == "Earnings"
                                ? "#,##0.00"
                                : "0.00";
                        }
                    }
                    else if (col.DataType == typeof(int) || col.DataType == typeof(long))
                    {
                        cell.Value = Convert.ToInt64(val);
                    }
                    else
                    {
                        string strVal = val.ToString();
                        cell.Value = strVal;

                        // Conditional formatting for non-null string values
                        if (col.ColumnName == "Status" && strVal == "Still Inside")
                            cell.Style.Font.FontColor = XLColor.OrangeRed;
                        else if (col.ColumnName == "Variance" && dt.Columns.Contains("VarianceMinutes") && dr["VarianceMinutes"] != DBNull.Value)
                        {
                            int varMin = Convert.ToInt32(dr["VarianceMinutes"]);
                            // VarianceMinutes = TimeSpent - Required: negative = under (red), positive = over (green)
                            cell.Style.Font.FontColor = varMin < 0 ? XLColor.Red : XLColor.FromHtml("#28A745");
                            cell.Style.Font.Bold = true;
                        }
                        else if (col.ColumnName == "TimeSpent" && isStillInside)
                        {
                            cell.Style.Font.FontColor = XLColor.FromHtml("#008000");
                            cell.Style.Font.Bold = true;
                        }
                    }

                    if (alt)
                        cell.Style.Fill.BackgroundColor = XLColor.FromHtml("#F9F9F9");
                }
                alt = !alt;
                row++;
            }
            lastDataRow = row - 1;
        }

        /// <summary>
        /// Writes a totals row with SUM formulas for Scans and Earnings columns.
        /// </summary>
        private void WriteXlAutoSumRow(IXLWorksheet ws, int startRow, DataTable dt, string reportType, System.Collections.Generic.HashSet<string> excludeCols, int headerRow, int lastDataRow)
        {
            if (lastDataRow < headerRow + 1)
                return; // no data rows to sum

            var displayCols = new System.Collections.Generic.List<DataColumn>();
            foreach (DataColumn col in dt.Columns)
                if (!excludeCols.Contains(col.ColumnName))
                    displayCols.Add(col);

            int sumRow = lastDataRow + 1;

            // Identify which columns should get a SUM formula
            var sumColumns = new System.Collections.Generic.HashSet<string>(StringComparer.OrdinalIgnoreCase)
            {
                "Scans", "ScanCount", "Earnings"
            };

            // First data row is headerRow + 1
            int firstDataRow = headerRow + 1;

            bool hasSumColumn = false;
            for (int c = 0; c < displayCols.Count; c++)
            {
                string colName = displayCols[c].ColumnName;
                if (sumColumns.Contains(colName))
                {
                    hasSumColumn = true;
                    break;
                }
            }

            if (!hasSumColumn)
                return;

            for (int c = 0; c < displayCols.Count; c++)
            {
                var cell = ws.Cell(sumRow, c + 1);
                string colName = displayCols[c].ColumnName;

                if (c == 0)
                {
                    // Label in the first column
                    cell.Value = "TOTAL";
                    cell.Style.Font.Bold = true;
                    cell.Style.Font.FontColor = XLColor.FromHtml("#0078D4");
                }

                if (sumColumns.Contains(colName))
                {
                    // Excel column letter
                    string colLetter = GetExcelColumnLetter(c + 1);
                    cell.FormulaA1 = $"SUM({colLetter}{firstDataRow}:{colLetter}{lastDataRow})";
                    cell.Style.Font.Bold = true;
                    cell.Style.Font.FontColor = XLColor.FromHtml("#0078D4");
                    if (colName == "Earnings")
                        cell.Style.NumberFormat.Format = "#,##0.00";
                }
            }

            // Light top border on the totals row
            ws.Range(sumRow, 1, sumRow, displayCols.Count).Style.Border.TopBorder = XLBorderStyleValues.Thin;
            ws.Range(sumRow, 1, sumRow, displayCols.Count).Style.Border.TopBorderColor = XLColor.FromHtml("#0078D4");
        }

        private string GetExcelColumnLetter(int columnNumber)
        {
            string letter = "";
            while (columnNumber > 0)
            {
                int mod = (columnNumber - 1) % 26;
                letter = (char)('A' + mod) + letter;
                columnNumber = (columnNumber - 1) / 26;
            }
            return letter;
        }

