        protected void btnExportPDF_Click(object sender, EventArgs e)
        {
            try
            {
                if (!TryGetDateRange(out DateTime fromDate, out DateTime toDate))
                    return;

                string siteId = ddlSites.SelectedValue;
                string reportType = ddlReportType.SelectedValue;
                string siteName = ddlSites.SelectedItem != null ? ddlSites.SelectedItem.Text : "All Sites";
                string username = Session["Username"]?.ToString() ?? "Unknown";

                DataTable reportData = GetReportDataTable(siteId, fromDate, toDate, reportType);

                if (reportData == null || reportData.Rows.Count == 0)
                {
                    lblMessage.ForeColor = System.Drawing.Color.Red;
                    lblMessage.Text = "No data to export. Generate a report first.";
                    return;
                }

                string reportTitle = GetReportTitle(reportType);
                string fileName = $"TimeAttendance_{reportType}_{fromDate:yyyyMMdd}_to_{toDate:yyyyMMdd}.pdf";

                using (MemoryStream ms = new MemoryStream())
                {
                    Document doc = new Document(PageSize.A4.Rotate(), 25, 25, 30, 30);
                    PdfWriter.GetInstance(doc, ms);
                    doc.Open();

                    Font titleFont = FontFactory.GetFont(FontFactory.HELVETICA_BOLD, 14, BaseColor.BLACK);
                    Font subtitleFont = FontFactory.GetFont(FontFactory.HELVETICA, 10, BaseColor.DARK_GRAY);
                    Font headerFont = FontFactory.GetFont(FontFactory.HELVETICA_BOLD, 8, BaseColor.WHITE);
                    Font cellFont = FontFactory.GetFont(FontFactory.HELVETICA, 8, BaseColor.BLACK);
                    Font cellBoldFont = FontFactory.GetFont(FontFactory.HELVETICA_BOLD, 8, BaseColor.BLACK);

                    BaseColor headerBg = new BaseColor(0, 120, 212);
                    BaseColor altRowBg = new BaseColor(249, 249, 249);

                    // Title
                    doc.Add(new Paragraph($"Time & Attendance - {reportTitle}", titleFont));
                    doc.Add(new Paragraph($"Site: {siteName}", subtitleFont));
                    doc.Add(new Paragraph($"Period: {fromDate:yyyy-MM-dd} to {toDate:yyyy-MM-dd}", subtitleFont));
                    doc.Add(new Paragraph($"Generated: {DateTime.Now:yyyy-MM-dd HH:mm:ss} by {username}", subtitleFont));
                    doc.Add(new Paragraph(" "));

                    // Determine visible columns (exclude internal ones)
                    var excludeCols = new System.Collections.Generic.HashSet<string>(StringComparer.OrdinalIgnoreCase)
                    {
                        "HasShift", "VarianceMinutes"
                    };
                    if (!chkIncludeFinancials.Checked)
                    {
                        excludeCols.Add("PayType");
                        excludeCols.Add("Earnings");
                    }

                    var displayCols = new System.Collections.Generic.List<DataColumn>();
                    foreach (DataColumn col in reportData.Columns)
                    {
                        if (!excludeCols.Contains(col.ColumnName))
                            displayCols.Add(col);
                    }

                    PdfPTable table = new PdfPTable(displayCols.Count);
                    table.WidthPercentage = 100;

                    // Headers
                    foreach (DataColumn col in displayCols)
                    {
                        PdfPCell hCell = new PdfPCell(new Phrase(FormatColumnHeader(col.ColumnName), headerFont));
                        hCell.BackgroundColor = headerBg;
                        hCell.Padding = 4;
                        table.AddCell(hCell);
                    }

                    // Data rows
                    int rowIdx = 0;
                    foreach (DataRow row in reportData.Rows)
                    {
                        bool isStillInside = reportData.Columns.Contains("Status") && row["Status"]?.ToString() == "Still Inside";
                        BaseColor rowBg = rowIdx % 2 == 1 ? altRowBg : BaseColor.WHITE;
                        foreach (DataColumn col in displayCols)
                        {
                            object val = row[col];
                            string cellValue = "";
                            if (val != DBNull.Value && val != null)
                            {
                                if (col.DataType == typeof(DateTime))
                                {
                                    DateTime dtVal = (DateTime)val;
                                    cellValue = col.ColumnName.Contains("Date") || col.ColumnName == "WorkDate"
                                        ? dtVal.ToString("yyyy-MM-dd")
                                        : dtVal.ToString("HH:mm:ss");
                                }
                                else if (col.DataType == typeof(decimal) || col.DataType == typeof(double))
                                {
                                    if ((col.ColumnName == "Earnings" || col.ColumnName == "BasicPay") && isStillInside)
                                        cellValue = "";
                                    else
                                        cellValue = Convert.ToDecimal(val).ToString("0.00");
                                }
                                else
                                {
                                    cellValue = val.ToString();
                                }
                            }
                            AddPdfCell(table, cellValue, cellFont, rowBg);
                        }
                        rowIdx++;
                    }

                    doc.Add(table);

                    // Footer
                    Paragraph footer = new Paragraph(
                        $"\nReport generated on {DateTime.Now:yyyy-MM-dd HH:mm:ss} by {username}" +
                        $"\nRecords: {reportData.Rows.Count}",
                        subtitleFont);
                    footer.SpacingBefore = 15;
                    doc.Add(footer);

                    doc.Close();

                    byte[] pdfBytes = ms.ToArray();

                    if (!Response.IsClientConnected)
                        return;

                    Response.Clear();
                    Response.ContentType = "application/pdf";
                    Response.AddHeader("Content-Disposition", $"attachment; filename={fileName}");
                    Response.OutputStream.Write(pdfBytes, 0, pdfBytes.Length);
                    Response.OutputStream.Flush();
                    _exportCompleted = true;
                    HttpContext.Current.ApplicationInstance.CompleteRequest();
                }
            }
            catch (HttpException httpEx) when (IsClientDisconnectError(httpEx))
            {
                // Client closed the connection (e.g. cancelled download) — safe to ignore
                System.Diagnostics.Debug.WriteLine($"Client disconnected during PDF export: {httpEx.Message}");
            }
            catch (Exception ex)
            {
                if (Response.IsClientConnected)
                {
                    lblMessage.ForeColor = System.Drawing.Color.Red;
                    lblMessage.Text = "Error exporting to PDF.";
                }
            }
        }

        private void AddPdfCell(PdfPTable table, string text, Font font, BaseColor bgColor)
        {
            PdfPCell cell = new PdfPCell(new Phrase(text, font));
            cell.BackgroundColor = bgColor;
            cell.Padding = 3;
            table.AddCell(cell);
        }

        // ============================
        // PDF Helper: Get Payroll Finance Data
        // ============================

        private DataTable GetPayrollFinanceData(string siteId, DateTime fromDate, DateTime toDate)
        {
            try
            {
                using (SqlConnection conn = new SqlConnection(_connStr))
                {
                    string siteFilter = !string.IsNullOrEmpty(siteId)
                        ? " AND CAST(r.SiteId AS NVARCHAR(MAX)) = @SiteID"
                        : "";

                    string query = @"
SELECT 
    r.PersonName,
    MAX(r.CardNumber) AS EmployeeCode,
    MAX(d.DepartmentName) AS Department,
    MAX(e.PayType) AS PayType,
    MAX(e.HourlyRate) AS HourlyRate,
    MAX(e.WeeklyRate) AS WeeklyRate,
    MAX(e.MonthlyRate) AS MonthlyRate,
    MAX(sh.ShiftName) AS ShiftName,
    CONVERT(VARCHAR(5), MAX(sh.StartTime), 108) AS ShiftStart,
    CONVERT(VARCHAR(5), MAX(sh.EndTime), 108) AS ShiftEnd,
    CAST(CASE WHEN MAX(sh.StartTime) IS NOT NULL AND MAX(sh.EndTime) IS NOT NULL
         THEN DATEDIFF(MINUTE, CAST(MAX(sh.StartTime) AS TIME), CAST(MAX(sh.EndTime) AS TIME)) / 60.0
         ELSE 0 END AS DECIMAL(10,2)) AS DailyRequiredHours,
    CONVERT(DATE, r.Timestamp) AS WorkDate,
    MIN(r.Timestamp) AS ClockIn,
    CASE WHEN MIN(r.Timestamp) = MAX(r.Timestamp) THEN NULL ELSE MAX(r.Timestamp) END AS ClockOut,
    CASE WHEN MIN(r.Timestamp) = MAX(r.Timestamp) THEN 'Still Inside' ELSE 'Clocked Out' END AS Status,
    CAST(CASE 
        WHEN MIN(r.Timestamp) = MAX(r.Timestamp) THEN 0
        WHEN MAX(sh.StartTime) IS NOT NULL
            THEN DATEDIFF(MINUTE, CAST(MAX(sh.StartTime) AS TIME), CAST(MAX(r.Timestamp) AS TIME)) / 60.0
        ELSE DATEDIFF(MINUTE, MIN(r.Timestamp), MAX(r.Timestamp)) / 60.0
    END AS DECIMAL(10,2)) AS ActualHours,
    CAST(CASE 
        WHEN MAX(sh.StartTime) IS NOT NULL AND MAX(sh.EndTime) IS NOT NULL THEN
            CASE WHEN MIN(r.Timestamp) = MAX(r.Timestamp) THEN 0
            ELSE 
                (DATEDIFF(MINUTE, CAST(MAX(sh.StartTime) AS TIME), CAST(MAX(r.Timestamp) AS TIME)) / 60.0)
                - (DATEDIFF(MINUTE, CAST(MAX(sh.StartTime) AS TIME), CAST(MAX(sh.EndTime) AS TIME)) / 60.0)
            END
        ELSE 0
    END AS DECIMAL(10,2)) AS OvertimeHours,
    ISNULL((SELECT SUM(a.Amount) FROM Allowances a WHERE a.EmployeeID = MAX(e.EmployeeID) AND a.IsActive = 1
        AND a.EffectiveFromDate <= CONVERT(DATE, r.Timestamp) 
        AND (a.EffectiveToDate IS NULL OR a.EffectiveToDate >= CONVERT(DATE, r.Timestamp))), 0) AS Allowances,
    ISNULL((SELECT SUM(dd.Amount) FROM Deductions dd WHERE dd.EmployeeID = MAX(e.EmployeeID) AND dd.IsActive = 1
        AND dd.EffectiveFromDate <= CONVERT(DATE, r.Timestamp) 
        AND (dd.EffectiveToDate IS NULL OR dd.EffectiveToDate >= CONVERT(DATE, r.Timestamp))), 0) AS Deductions
FROM ReaderEvents r
LEFT JOIN Employees e ON r.PersonName = e.NameSurname 
    AND CAST(r.SiteId AS NVARCHAR(MAX)) = CAST(e.SiteID AS NVARCHAR(MAX))
LEFT JOIN Shifts sh ON sh.EmployeeID = e.EmployeeID AND sh.IsActive = 1
LEFT JOIN Departments d ON e.DepartmentID = d.DepartmentID
WHERE r.Timestamp BETWEEN @FromDate AND @ToDate
  AND r.PersonName IS NOT NULL AND r.PersonName <> ''" + siteFilter.Replace("SiteId", "r.SiteId") + @"
GROUP BY r.PersonName, CONVERT(DATE, r.Timestamp)
ORDER BY r.PersonName, WorkDate";

                    using (SqlCommand cmd = new SqlCommand(query, conn))
                    {
                        cmd.Parameters.AddWithValue("@FromDate", fromDate.Date);
                        cmd.Parameters.AddWithValue("@ToDate", toDate.Date.AddDays(1).AddSeconds(-1));
                        if (!string.IsNullOrEmpty(siteId))
                            cmd.Parameters.AddWithValue("@SiteID", siteId);
                        cmd.CommandTimeout = GetCommandTimeout(fromDate, toDate);

                        using (SqlDataAdapter da = new SqlDataAdapter(cmd))
                        {
                            DataTable dt = new DataTable();
                            da.Fill(dt);
                            return dt;
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"GetPayrollFinanceData error: {ex.Message}");
                return null;
            }
        }

