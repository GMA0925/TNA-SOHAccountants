        protected void gvReports_RowDataBound(object sender, GridViewRowEventArgs e)
        {
            if (e.Row.RowType != DataControlRowType.DataRow)
                return;

            DataRowView drv = e.Row.DataItem as DataRowView;
            if (drv == null)
                return;

            string reportType = ddlReportType.SelectedValue;

            // Per Site: Date(0), Person(1), Code(2), In(3), ShiftStart(4), Out(5), ShiftEnd(6), Status(7), TimeSpent(8), Required(9), Variance(10), Scans(11)
            if (reportType == "Site")
            {
                bool isStillInside = drv.Row.Table.Columns.Contains("Status") && drv["Status"]?.ToString() == "Still Inside";
                bool hasShift = drv.Row.Table.Columns.Contains("HasShift") && drv["HasShift"] != DBNull.Value && Convert.ToInt32(drv["HasShift"]) == 1;

                // Shift Start — show exclamation if no shift assigned
                if (!hasShift && e.Row.Cells.Count > 4)
                {
                    e.Row.Cells[4].Text = "\u2757 No shift assigned";
                    e.Row.Cells[4].ForeColor = System.Drawing.Color.FromArgb(204, 102, 0);
                    e.Row.Cells[4].Font.Bold = true;
                }

                // Shift End — show exclamation if no shift assigned
                if (!hasShift && e.Row.Cells.Count > 6)
                {
                    e.Row.Cells[6].Text = "\u2757 No shift assigned";
                    e.Row.Cells[6].ForeColor = System.Drawing.Color.FromArgb(204, 102, 0);
                    e.Row.Cells[6].Font.Bold = true;
                }

                // Highlight "Still Inside" status
                if (isStillInside && e.Row.Cells.Count > 7)
                {
                    e.Row.Cells[7].ForeColor = System.Drawing.Color.OrangeRed;
                    e.Row.Cells[7].Font.Bold = true;
                }

                // Live TimeSpent — show in green with clock icon for Still Inside
                if (isStillInside && e.Row.Cells.Count > 8 && !string.IsNullOrEmpty(e.Row.Cells[8].Text))
                {
                    e.Row.Cells[8].Text = "\u23F1 " + e.Row.Cells[8].Text;
                    e.Row.Cells[8].ForeColor = System.Drawing.Color.FromArgb(0, 128, 0);
                    e.Row.Cells[8].Font.Bold = true;
                }

                // RequiredHours — center align; show warning if no shift assigned
                if (e.Row.Cells.Count > 9)
                {
                    e.Row.Cells[9].HorizontalAlign = HorizontalAlign.Center;
                }
                if (!hasShift && e.Row.Cells.Count > 9)
                {
                    e.Row.Cells[9].Text = "\u26A0\uFE0F Still to be set";
                    e.Row.Cells[9].ForeColor = System.Drawing.Color.FromArgb(204, 102, 0);
                    e.Row.Cells[9].Font.Bold = true;
                    e.Row.Cells[9].Font.Size = FontUnit.Parse("11px");
                }

                // Variance — show N/A if no shift, red if still has remaining time, green if completed/exceeded
                if (!hasShift && e.Row.Cells.Count > 10)
                {
                    e.Row.Cells[10].Text = "N/A";
                    e.Row.Cells[10].ForeColor = System.Drawing.Color.Gray;
                }
                else if (drv.Row.Table.Columns.Contains("VarianceMinutes") && drv["VarianceMinutes"] != DBNull.Value && e.Row.Cells.Count > 10)
                {
                    int varianceMin;
                    if (int.TryParse(drv["VarianceMinutes"].ToString(), out varianceMin))
                    {
                        if (varianceMin > 0)
                        {
                            // Remaining time left — has not completed required hours
                            e.Row.Cells[10].ForeColor = System.Drawing.Color.Red;
                            e.Row.Cells[10].Font.Bold = true;
                        }
                        else
                        {
                            // Completed or exceeded required hours
                            e.Row.Cells[10].ForeColor = System.Drawing.Color.FromArgb(0, 128, 0);
                            e.Row.Cells[10].Font.Bold = true;
                        }
                    }
                }
            }
            // Per Person: Person(0), Code(1), Scans(2), First(3), ShiftStart(4), Last(5), ShiftEnd(6), TimeSpent(7), Required(8), Variance(9)
            else if (reportType == "Person")
            {
                bool isStillInside = drv.Row.Table.Columns.Contains("ScanCount") && drv["ScanCount"] != DBNull.Value && Convert.ToInt32(drv["ScanCount"]) == 1;
                bool hasShift = drv.Row.Table.Columns.Contains("HasShift") && drv["HasShift"] != DBNull.Value && Convert.ToInt32(drv["HasShift"]) == 1;

                // Shift Start — show exclamation if no shift assigned
                if (!hasShift && e.Row.Cells.Count > 4)
                {
                    e.Row.Cells[4].Text = "\u2757 No shift assigned";
                    e.Row.Cells[4].ForeColor = System.Drawing.Color.FromArgb(204, 102, 0);
                    e.Row.Cells[4].Font.Bold = true;
                }

                // Shift End — show exclamation if no shift assigned
                if (!hasShift && e.Row.Cells.Count > 6)
                {
                    e.Row.Cells[6].Text = "\u2757 No shift assigned";
                    e.Row.Cells[6].ForeColor = System.Drawing.Color.FromArgb(204, 102, 0);
                    e.Row.Cells[6].Font.Bold = true;
                }

                // Live TimeSpent — show in green with clock icon for Still Inside
                if (isStillInside && e.Row.Cells.Count > 7 && !string.IsNullOrEmpty(e.Row.Cells[7].Text))
                {
                    e.Row.Cells[7].Text = "\u23F1 " + e.Row.Cells[7].Text;
                    e.Row.Cells[7].ForeColor = System.Drawing.Color.FromArgb(0, 128, 0);
                    e.Row.Cells[7].Font.Bold = true;
                }

                // RequiredHours — center align; show warning if no shift assigned
                if (e.Row.Cells.Count > 8)
                {
                    e.Row.Cells[8].HorizontalAlign = HorizontalAlign.Center;
                }
                if (!hasShift && e.Row.Cells.Count > 8)
                {
                    e.Row.Cells[8].Text = "\u26A0\uFE0F Still to be set";
                    e.Row.Cells[8].ForeColor = System.Drawing.Color.FromArgb(204, 102, 0);
                    e.Row.Cells[8].Font.Bold = true;
                    e.Row.Cells[8].Font.Size = FontUnit.Parse("11px");
                }

                // Variance — show N/A if no shift, red if still has remaining time, green if completed/exceeded
                if (!hasShift && e.Row.Cells.Count > 9)
                {
                    e.Row.Cells[9].Text = "N/A";
                    e.Row.Cells[9].ForeColor = System.Drawing.Color.Gray;
                }
                else if (drv.Row.Table.Columns.Contains("VarianceMinutes") && drv["VarianceMinutes"] != DBNull.Value && e.Row.Cells.Count > 9)
                {
                    int varianceMin;
                    if (int.TryParse(drv["VarianceMinutes"].ToString(), out varianceMin))
                    {
                        if (varianceMin > 0)
                        {
                            // Remaining time left — has not completed required hours
                            e.Row.Cells[9].ForeColor = System.Drawing.Color.Red;
                            e.Row.Cells[9].Font.Bold = true;
                        }
                        else
                        {
                            // Completed or exceeded required hours
                            e.Row.Cells[9].ForeColor = System.Drawing.Color.FromArgb(0, 128, 0);
                            e.Row.Cells[9].Font.Bold = true;
                        }
                    }
                }
            }
        }

