        protected void btnExportExcel_Click(object sender, EventArgs e)
        {
            try
            {
                if (!TryGetDateRange(out DateTime fromDate, out DateTime toDate))
                    return;

                string siteId = ddlSites.SelectedValue;
                string reportType = ddlReportType.SelectedValue;
                string siteName = ddlSites.SelectedItem != null ? ddlSites.SelectedItem.Text : "All Sites";
                bool includeFinancials = chkIncludeFinancials.Checked;
                string username = Session["Username"]?.ToString() ?? "Unknown";

                DataTable reportData = GetReportDataTable(siteId, fromDate, toDate, reportType);

                if (reportData == null || reportData.Rows.Count == 0)
                {
                    lblMessage.ForeColor = System.Drawing.Color.Red;
                    lblMessage.Text = "No data to export. Generate a report first.";
                    return;
                }

                var excludeCols = new System.Collections.Generic.HashSet<string>(StringComparer.OrdinalIgnoreCase)
                {
                    "HasShift", "VarianceMinutes"
                };
                if (!includeFinancials)
                {
                    excludeCols.Add("PayType");
                    excludeCols.Add("Earnings");
                }

                string reportTitle = GetReportTitle(reportType);
                string fileName = $"TimeAttendance_{reportType}_{fromDate:yyyyMMdd}_to_{toDate:yyyyMMdd}.xlsx";

                using (var workbook = new XLWorkbook())
                {
                    // ===== SUMMARY SHEET =====
                    var summarySheet = workbook.Worksheets.Add("Summary");
                    int summaryRow = WriteSummarySheetHeader(summarySheet, reportTitle + " - Summary", siteName, fromDate, toDate, reportData.Rows.Count, username);

                    if (reportType == "Site" && reportData.Columns.Contains("WorkDate"))
                        summaryRow = WriteXlDailySummary(summarySheet, summaryRow, reportData);
                    else
                    {
                        summarySheet.Cell(summaryRow, 1).Value = "Total Records";
                        summarySheet.Cell(summaryRow, 2).Value = reportData.Rows.Count;
                        summaryRow++;
                    }

                    summaryRow++; // blank separator before full data table
                    int summaryLastDataRow;
                    WriteXlDataTableCore(summarySheet, summaryRow, reportData, reportType, excludeCols, out summaryLastDataRow);
                    WriteXlAutoSumRow(summarySheet, summaryRow, reportData, reportType, excludeCols, summaryRow, summaryLastDataRow);
                    SetColumnWidths(summarySheet);

                    // ===== PER-EMPLOYEE SHEETS (Site/Person reports) =====
                    if ((reportType == "Site" || reportType == "Person") && reportData.Columns.Contains("PersonName"))
                    {
                        var seen = new System.Collections.Generic.HashSet<string>(StringComparer.OrdinalIgnoreCase);
                        var employeeNames = new System.Collections.Generic.List<string>();
                        foreach (DataRow row in reportData.Rows)
                        {
                            string name = row["PersonName"]?.ToString() ?? "";
                            if (!string.IsNullOrEmpty(name) && seen.Add(name))
                                employeeNames.Add(name);
                        }

                        var usedSheetNames = new System.Collections.Generic.HashSet<string>(StringComparer.OrdinalIgnoreCase) { "Summary" };
                        foreach (string empName in employeeNames)
                        {
                            string sheetName = SanitizeSheetName(empName);
                            string candidate = sheetName;
                            int suffix = 2;
                            while (!usedSheetNames.Add(candidate))
                            {
                                string sfx = "_" + suffix;
                                candidate = sheetName.Length + sfx.Length > 31
                                    ? sheetName.Substring(0, 31 - sfx.Length) + sfx
                                    : sheetName + sfx;
                                suffix++;
                            }

                            DataRow[] empRows = reportData.Select($"PersonName = '{empName.Replace("'", "''")}'");
                            DataTable empTable = reportData.Clone();
                            foreach (DataRow row in empRows)
                                empTable.ImportRow(row);

                            var empSheet = workbook.Worksheets.Add(candidate);
                            int empRow = WriteSummarySheetHeader(empSheet, empName, siteName, fromDate, toDate, empTable.Rows.Count, username);
                            int empLastDataRow;
                            WriteXlDataTableCore(empSheet, empRow, empTable, reportType, excludeCols, out empLastDataRow);
                            WriteXlAutoSumRow(empSheet, empRow, empTable, reportType, excludeCols, empRow, empLastDataRow);
                            SetColumnWidths(empSheet);
                        }
                    }
                    else
                    {
                        // Single data sheet for non-employee reports
                        var dataSheet = workbook.Worksheets.Add("Data");
                        int dataRow = WriteSummarySheetHeader(dataSheet, reportTitle + " - Data", siteName, fromDate, toDate, reportData.Rows.Count, username);
                        int dataLastRow;
                        WriteXlDataTableCore(dataSheet, dataRow, reportData, reportType, excludeCols, out dataLastRow);
                        WriteXlAutoSumRow(dataSheet, dataRow, reportData, reportType, excludeCols, dataRow, dataLastRow);
                        SetColumnWidths(dataSheet);
                    }

                    Response.Clear();
                    Response.ContentType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
                    Response.AddHeader("Content-Disposition", $"attachment; filename={fileName}");

                    using (var ms = new MemoryStream())
                    {
                        workbook.SaveAs(ms);
                        Response.BinaryWrite(ms.ToArray());
                    }
                }

                _exportCompleted = true;
                HttpContext.Current.ApplicationInstance.CompleteRequest();
            }
            catch (Exception ex)
            {
                if (Response.IsClientConnected)
                {
                    // Extract the first stack frame that contains a line number
                    string lineInfo = "";
                    if (!string.IsNullOrEmpty(ex.StackTrace))
                    {
                        foreach (string frame in ex.StackTrace.Split(new[] { '\n' }, StringSplitOptions.RemoveEmptyEntries))
                        {
                            if (frame.Contains(":line "))
                            {
                                lineInfo = " [" + frame.Trim() + "]";
                                break;
                            }
                        }
                    }
                    lblMessage.ForeColor = System.Drawing.Color.Red;
                    lblMessage.Text = $"Excel export error: {ex.GetType().Name} — {ex.Message}{lineInfo}";
                }
            }
        }

