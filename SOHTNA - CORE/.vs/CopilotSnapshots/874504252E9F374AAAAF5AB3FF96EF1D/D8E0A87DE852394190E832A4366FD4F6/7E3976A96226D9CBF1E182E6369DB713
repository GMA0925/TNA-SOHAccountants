        private bool TryGetDateRange(out DateTime fromDate, out DateTime toDate)
        {
            fromDate = DateTime.MinValue;
            toDate = DateTime.MinValue;

            if (string.IsNullOrWhiteSpace(txtFromDate.Text) || string.IsNullOrWhiteSpace(txtToDate.Text))
            {
                lblMessage.ForeColor = System.Drawing.Color.Red;
                lblMessage.Text = "Both From Date and To Date are required.";
                return false;
            }

            if (!DateTime.TryParse(txtFromDate.Text, out fromDate))
            {
                lblMessage.ForeColor = System.Drawing.Color.Red;
                lblMessage.Text = "From Date is not valid.";
                return false;
            }

            if (!DateTime.TryParse(txtToDate.Text, out toDate))
            {
                lblMessage.ForeColor = System.Drawing.Color.Red;
                lblMessage.Text = "To Date is not valid.";
                return false;
            }

            if (fromDate > toDate)
            {
                lblMessage.ForeColor = System.Drawing.Color.Red;
                lblMessage.Text = "From Date cannot be after To Date.";
                return false;
            }

            return true;
        }

        // ============================
        // Report Generation
        // ============================

        protected void btnGenerateReport_Click(object sender, EventArgs e)
        {
            try
            {
                if (!TryGetDateRange(out DateTime fromDate, out DateTime toDate))
                    return;

                string siteId = ddlSites.SelectedValue;
                string reportType = ddlReportType.SelectedValue;

                LoadReportData(siteId, fromDate, toDate, reportType);

                if (gvReports.Rows.Count > 0)
                {
                    int days = (toDate - fromDate).Days;
                    string rangeNote = days > 31 ? $" (large range: {days} days — export may take longer)" : "";
                    lblMessage.ForeColor = System.Drawing.Color.Green;
                    lblMessage.Text = $"Report generated: {gvReports.Rows.Count} record(s) found.{rangeNote}";
                }
                else
                {
                    lblMessage.ForeColor = System.Drawing.Color.Orange;
                    lblMessage.Text = "No records found for the selected criteria.";
                }
            }
            catch (Exception ex)
            {
                lblMessage.ForeColor = System.Drawing.Color.Red;
                lblMessage.Text = "Error generating report.";
            }
        }

        private void LoadReportData(string siteId, DateTime fromDate, DateTime toDate, string reportType)
        {
            try
            {
                using (SqlConnection conn = new SqlConnection(_connStr))
                {
                    string query = BuildQuery(siteId, reportType);

                    using (SqlCommand cmd = new SqlCommand(query, conn))
                    {
                        cmd.Parameters.AddWithValue("@FromDate", fromDate.Date);
                        cmd.Parameters.AddWithValue("@ToDate", toDate.Date.AddDays(1).AddSeconds(-1));

                        // Use client local time from hidden field; fall back to server time
                        DateTime now;
                        if (!string.IsNullOrEmpty(hfClientNow.Value) && DateTime.TryParse(hfClientNow.Value, out DateTime clientNow))
                        {
                            now = toDate.Date == clientNow.Date
                                ? clientNow
                                : toDate.Date.Add(clientNow.TimeOfDay);
                        }
                        else
                        {
                            now = toDate.Date == DateTime.Today
                                ? DateTime.Now
                                : toDate.Date.Add(DateTime.Now.TimeOfDay);
                        }
                        cmd.Parameters.AddWithValue("@Now", now);

                        if (!string.IsNullOrEmpty(siteId))
                            cmd.Parameters.AddWithValue("@SiteID", siteId);

                        cmd.CommandTimeout = GetCommandTimeout(fromDate, toDate);

                        using (SqlDataAdapter da = new SqlDataAdapter(cmd))
                        {
                            DataTable dt = new DataTable();
                            da.Fill(dt);

                            ConfigureGridColumns(reportType);

                            gvReports.DataSource = dt;
                            gvReports.DataBind();
                        }
                    }
                }
            }
            catch (SqlException sqlEx)
            {
                System.Diagnostics.Debug.WriteLine($"SQL Error in LoadReportData: {sqlEx.Message}");
                lblMessage.ForeColor = System.Drawing.Color.Red;
                lblMessage.Text = "Database error loading report data.";
            }
            catch (Exception ex)
            {
                lblMessage.ForeColor = System.Drawing.Color.Red;
                lblMessage.Text = "Error loading report data.";
            }
        }

        private string BuildQuery(string siteId, string reportType)
        {
            string query;
            string siteFilter = !string.IsNullOrEmpty(siteId)
                ? " AND CAST(SiteId AS NVARCHAR(MAX)) = @SiteID"
                : "";

            switch (reportType)
            {
                case "Site":
                default:
                    // Per Site — daily clock-in/out summary per person
                    // TimeSpent = MIN(ClockOut, ShiftEnd) – MAX(ClockIn, ShiftStart), capped to shift window
                    // Variance  = TimeSpent – RequiredHours (positive = over, negative = under)
                    // Earnings  = RequiredHours × rate (employees only earn shift hours)
                    // EffectiveNow: for Still Inside on today use @Now capped at ShiftEnd;
                    //               for historical dates use end-of-day capped at ShiftEnd.
                    query = @"
                        ;WITH cte AS (
                            SELECT
                                CONVERT(DATE, r.Timestamp) AS WorkDate,
                                r.PersonName,
                                MAX(r.CardNumber) AS CardNumber,
                                MIN(r.Timestamp) AS ClockIn,
                                CASE WHEN MIN(r.Timestamp) = MAX(r.Timestamp) THEN NULL ELSE MAX(r.Timestamp) END AS ClockOut,
                                CASE WHEN MIN(r.Timestamp) = MAX(r.Timestamp) THEN 'Still Inside' ELSE 'Clocked Out' END AS Status,
                                MAX(sh.StartTime) AS ShiftStart,
                                MAX(sh.EndTime) AS ShiftEnd,
                                COUNT(*) AS Scans,
                                CASE WHEN MAX(e.EmployeeID) IS NULL THEN 0 WHEN MAX(sh.ShiftID) IS NULL THEN 0 ELSE 1 END AS HasShift,
                                MAX(e.PayType) AS PayType,
                                MAX(e.HourlyRate) AS HourlyRate,
                                MAX(e.WeeklyRate) AS WeeklyRate,
                                MAX(e.MonthlyRate) AS MonthlyRate,
                                -- EffectiveOut: actual clock-out, or @Now/end-of-day for Still Inside
                                CASE WHEN MIN(r.Timestamp) = MAX(r.Timestamp)
                                     THEN CASE WHEN CONVERT(DATE, MIN(r.Timestamp)) = CONVERT(DATE, @Now) THEN @Now
                                               ELSE DATEADD(SECOND, -1, DATEADD(DAY, 1, CONVERT(DATETIME, CONVERT(DATE, MIN(r.Timestamp)))))
                                          END
                                     ELSE MAX(r.Timestamp)
                                END AS EffectiveOut
                            FROM ReaderEvents r
                            LEFT JOIN Employees e ON r.PersonName = e.NameSurname
                                AND CAST(r.SiteId AS NVARCHAR(MAX)) = CAST(e.SiteID AS NVARCHAR(MAX))
                            LEFT JOIN EmployeeShifts esh ON esh.EmployeeID = e.EmployeeID AND esh.IsActive = 1
                            LEFT JOIN Shifts sh ON sh.ShiftID = esh.ShiftID AND sh.IsActive = 1
                            WHERE r.Timestamp BETWEEN @FromDate AND @ToDate
                              AND r.PersonName IS NOT NULL AND r.PersonName <> ''" + siteFilter.Replace("SiteId", "r.SiteId") + @"
                            GROUP BY CONVERT(DATE, r.Timestamp), r.PersonName
                        )
                        SELECT
                            WorkDate, PersonName, CardNumber, ClockIn,
                            CONVERT(VARCHAR(5), ShiftStart, 108) AS ShiftStartTime,
                            ClockOut,
                            CONVERT(VARCHAR(5), ShiftEnd, 108) AS ShiftEndTime,
                            Status,
                            -- TimeSpent: MIN(EffectiveOut, ShiftEnd) - MAX(ClockIn, ShiftStart), capped >= 0
                            CASE WHEN ShiftStart IS NOT NULL AND ShiftEnd IS NOT NULL THEN
                                CAST(
                                    CASE WHEN DATEDIFF(MINUTE,
                                            CASE WHEN CAST(ClockIn AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(ClockIn AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                            CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                         ) < 0 THEN 0
                                         ELSE DATEDIFF(MINUTE,
                                            CASE WHEN CAST(ClockIn AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(ClockIn AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                            CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                         )
                                    END
                                / 60 AS VARCHAR(10)) + 'h ' +
                                CAST(
                                    CASE WHEN DATEDIFF(MINUTE,
                                            CASE WHEN CAST(ClockIn AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(ClockIn AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                            CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                         ) < 0 THEN 0
                                         ELSE DATEDIFF(MINUTE,
                                            CASE WHEN CAST(ClockIn AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(ClockIn AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                            CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                         )
                                    END
                                % 60 AS VARCHAR(10)) + 'm'
                            ELSE
                                -- No shift: raw clock-in to effective out
                                CAST(DATEDIFF(MINUTE, ClockIn, EffectiveOut) / 60 AS VARCHAR(10)) + 'h ' +
                                CAST(DATEDIFF(MINUTE, ClockIn, EffectiveOut) % 60 AS VARCHAR(10)) + 'm'
                            END AS TimeSpent,
                            -- RequiredHours
                            CASE WHEN ShiftStart IS NOT NULL AND ShiftEnd IS NOT NULL
                                 THEN CAST(DATEDIFF(MINUTE, CAST(ShiftStart AS TIME), CAST(ShiftEnd AS TIME)) / 60 AS VARCHAR(10)) + 'h ' +
                                      CAST(DATEDIFF(MINUTE, CAST(ShiftStart AS TIME), CAST(ShiftEnd AS TIME)) % 60 AS VARCHAR(10)) + 'm'
                                 ELSE NULL
                            END AS RequiredHours,
                            -- Variance = TimeSpent – RequiredHours (signed: positive = over, negative = under)
                            CASE WHEN ShiftStart IS NOT NULL AND ShiftEnd IS NOT NULL THEN
                                CASE WHEN (
                                    CASE WHEN DATEDIFF(MINUTE,
                                            CASE WHEN CAST(ClockIn AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(ClockIn AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                            CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                         ) < 0 THEN 0
                                         ELSE DATEDIFF(MINUTE,
                                            CASE WHEN CAST(ClockIn AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(ClockIn AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                            CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                         )
                                    END
                                    - DATEDIFF(MINUTE, CAST(ShiftStart AS TIME), CAST(ShiftEnd AS TIME))
                                ) >= 0 THEN
                                    CAST(ABS(
                                        CASE WHEN DATEDIFF(MINUTE,
                                                CASE WHEN CAST(ClockIn AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(ClockIn AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                                CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                             ) < 0 THEN 0
                                             ELSE DATEDIFF(MINUTE,
                                                CASE WHEN CAST(ClockIn AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(ClockIn AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                                CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                             )
                                        END
                                        - DATEDIFF(MINUTE, CAST(ShiftStart AS TIME), CAST(ShiftEnd AS TIME))
                                    ) / 60 AS VARCHAR(10)) + 'h ' +
                                    CAST(ABS(
                                        CASE WHEN DATEDIFF(MINUTE,
                                                CASE WHEN CAST(ClockIn AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(ClockIn AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                                CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                             ) < 0 THEN 0
                                             ELSE DATEDIFF(MINUTE,
                                                CASE WHEN CAST(ClockIn AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(ClockIn AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                                CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                             )
                                        END
                                        - DATEDIFF(MINUTE, CAST(ShiftStart AS TIME), CAST(ShiftEnd AS TIME))
                                    ) % 60 AS VARCHAR(10)) + 'm'
                                ELSE
                                    '-' +
                                    CAST(ABS(
                                        CASE WHEN DATEDIFF(MINUTE,
                                                CASE WHEN CAST(ClockIn AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(ClockIn AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                                CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                             ) < 0 THEN 0
                                             ELSE DATEDIFF(MINUTE,
                                                CASE WHEN CAST(ClockIn AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(ClockIn AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                                CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                             )
                                        END
                                        - DATEDIFF(MINUTE, CAST(ShiftStart AS TIME), CAST(ShiftEnd AS TIME))
                                    ) / 60 AS VARCHAR(10)) + 'h ' +
                                    CAST(ABS(
                                        CASE WHEN DATEDIFF(MINUTE,
                                                CASE WHEN CAST(ClockIn AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(ClockIn AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                                CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                             ) < 0 THEN 0
                                             ELSE DATEDIFF(MINUTE,
                                                CASE WHEN CAST(ClockIn AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(ClockIn AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                                CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                             )
                                        END
                                        - DATEDIFF(MINUTE, CAST(ShiftStart AS TIME), CAST(ShiftEnd AS TIME))
                                    ) % 60 AS VARCHAR(10)) + 'm'
                                END
                            ELSE NULL END AS Variance,
                            -- VarianceMinutes (signed integer for formatting)
                            CASE WHEN ShiftStart IS NOT NULL AND ShiftEnd IS NOT NULL THEN
                                CASE WHEN DATEDIFF(MINUTE,
                                        CASE WHEN CAST(ClockIn AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(ClockIn AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                        CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                     ) < 0 THEN 0
                                     ELSE DATEDIFF(MINUTE,
                                        CASE WHEN CAST(ClockIn AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(ClockIn AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                        CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                     )
                                END
                                - DATEDIFF(MINUTE, CAST(ShiftStart AS TIME), CAST(ShiftEnd AS TIME))
                            ELSE NULL END AS VarianceMinutes,
                            Scans, HasShift, PayType,
                            -- Earnings = RequiredHours × rate (only shift hours are paid)
                            CAST(
                                CASE WHEN ShiftStart IS NOT NULL AND ShiftEnd IS NOT NULL THEN
                                    DATEDIFF(MINUTE, CAST(ShiftStart AS TIME), CAST(ShiftEnd AS TIME)) / 60.0
                                    * CASE
                                        WHEN PayType = 'Hourly'  THEN ISNULL(HourlyRate, 0)
                                        WHEN PayType = 'Weekly'  THEN ISNULL(WeeklyRate, 0) / 40.0
                                        WHEN PayType = 'Monthly' THEN ISNULL(MonthlyRate, 0) / 176.0
                                        ELSE 0
                                      END
                                ELSE 0
                                END
                            AS DECIMAL(10,2)) AS Earnings
                        FROM cte
                        ORDER BY WorkDate DESC, PersonName";
                    break;

                case "Person":
                    // Per Person — aggregate summary across date range
                    // Same clamped shift-window logic as Site query
                    query = @"
                        ;WITH cte AS (
                            SELECT
                                r.PersonName,
                                MAX(r.CardNumber) AS CardNumber,
                                COUNT(*) AS ScanCount,
                                MIN(r.Timestamp) AS FirstScan,
                                MAX(r.Timestamp) AS LastScan,
                                MAX(sh.StartTime) AS ShiftStart,
                                MAX(sh.EndTime) AS ShiftEnd,
                                CASE WHEN MAX(e.EmployeeID) IS NULL THEN 0 WHEN MAX(sh.ShiftID) IS NULL THEN 0 ELSE 1 END AS HasShift,
                                MAX(e.PayType) AS PayType,
                                MAX(e.HourlyRate) AS HourlyRate,
                                MAX(e.WeeklyRate) AS WeeklyRate,
                                MAX(e.MonthlyRate) AS MonthlyRate,
                                CASE WHEN MIN(r.Timestamp) = MAX(r.Timestamp)
                                     THEN CASE WHEN CONVERT(DATE, MIN(r.Timestamp)) = CONVERT(DATE, @Now) THEN @Now
                                               ELSE DATEADD(SECOND, -1, DATEADD(DAY, 1, CONVERT(DATETIME, CONVERT(DATE, MIN(r.Timestamp)))))
                                          END
                                     ELSE MAX(r.Timestamp)
                                END AS EffectiveOut
                            FROM ReaderEvents r
                            LEFT JOIN Employees e ON r.PersonName = e.NameSurname
                                AND CAST(r.SiteId AS NVARCHAR(MAX)) = CAST(e.SiteID AS NVARCHAR(MAX))
                            LEFT JOIN EmployeeShifts esh ON esh.EmployeeID = e.EmployeeID AND esh.IsActive = 1
                            LEFT JOIN Shifts sh ON sh.ShiftID = esh.ShiftID AND sh.IsActive = 1
                            WHERE r.Timestamp BETWEEN @FromDate AND @ToDate
                              AND r.PersonName IS NOT NULL AND r.PersonName <> ''" + siteFilter.Replace("SiteId", "r.SiteId") + @"
                            GROUP BY r.PersonName
                        )
                        SELECT
                            PersonName, CardNumber, ScanCount, FirstScan,
                            CONVERT(VARCHAR(5), ShiftStart, 108) AS ShiftStartTime,
                            LastScan,
                            CONVERT(VARCHAR(5), ShiftEnd, 108) AS ShiftEndTime,
                            CASE WHEN ShiftStart IS NOT NULL AND ShiftEnd IS NOT NULL THEN
                                CAST(
                                    CASE WHEN DATEDIFF(MINUTE,
                                            CASE WHEN CAST(FirstScan AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(FirstScan AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                            CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                         ) < 0 THEN 0
                                         ELSE DATEDIFF(MINUTE,
                                            CASE WHEN CAST(FirstScan AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(FirstScan AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                            CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                         )
                                    END
                                / 60 AS VARCHAR(10)) + 'h ' +
                                CAST(
                                    CASE WHEN DATEDIFF(MINUTE,
                                            CASE WHEN CAST(FirstScan AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(FirstScan AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                            CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                         ) < 0 THEN 0
                                         ELSE DATEDIFF(MINUTE,
                                            CASE WHEN CAST(FirstScan AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(FirstScan AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                            CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                         )
                                    END
                                % 60 AS VARCHAR(10)) + 'm'
                            ELSE
                                CAST(DATEDIFF(MINUTE, FirstScan, EffectiveOut) / 60 AS VARCHAR(10)) + 'h ' +
                                CAST(DATEDIFF(MINUTE, FirstScan, EffectiveOut) % 60 AS VARCHAR(10)) + 'm'
                            END AS TimeSpent,
                            CASE WHEN ShiftStart IS NOT NULL AND ShiftEnd IS NOT NULL
                                 THEN CAST(DATEDIFF(MINUTE, CAST(ShiftStart AS TIME), CAST(ShiftEnd AS TIME)) / 60 AS VARCHAR(10)) + 'h ' +
                                      CAST(DATEDIFF(MINUTE, CAST(ShiftStart AS TIME), CAST(ShiftEnd AS TIME)) % 60 AS VARCHAR(10)) + 'm'
                                 ELSE NULL
                            END AS RequiredHours,
                            CASE WHEN ShiftStart IS NOT NULL AND ShiftEnd IS NOT NULL THEN
                                CASE WHEN (
                                    CASE WHEN DATEDIFF(MINUTE,
                                            CASE WHEN CAST(FirstScan AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(FirstScan AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                            CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                         ) < 0 THEN 0
                                         ELSE DATEDIFF(MINUTE,
                                            CASE WHEN CAST(FirstScan AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(FirstScan AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                            CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                         )
                                    END
                                    - DATEDIFF(MINUTE, CAST(ShiftStart AS TIME), CAST(ShiftEnd AS TIME))
                                ) >= 0 THEN
                                    CAST(ABS(
                                        CASE WHEN DATEDIFF(MINUTE,
                                                CASE WHEN CAST(FirstScan AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(FirstScan AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                                CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                             ) < 0 THEN 0
                                             ELSE DATEDIFF(MINUTE,
                                                CASE WHEN CAST(FirstScan AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(FirstScan AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                                CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                             )
                                        END
                                        - DATEDIFF(MINUTE, CAST(ShiftStart AS TIME), CAST(ShiftEnd AS TIME))
                                    ) / 60 AS VARCHAR(10)) + 'h ' +
                                    CAST(ABS(
                                        CASE WHEN DATEDIFF(MINUTE,
                                                CASE WHEN CAST(FirstScan AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(FirstScan AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                                CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                             ) < 0 THEN 0
                                             ELSE DATEDIFF(MINUTE,
                                                CASE WHEN CAST(FirstScan AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(FirstScan AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                                CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                             )
                                        END
                                        - DATEDIFF(MINUTE, CAST(ShiftStart AS TIME), CAST(ShiftEnd AS TIME))
                                    ) % 60 AS VARCHAR(10)) + 'm'
                                ELSE
                                    '-' +
                                    CAST(ABS(
                                        CASE WHEN DATEDIFF(MINUTE,
                                                CASE WHEN CAST(FirstScan AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(FirstScan AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                                CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                             ) < 0 THEN 0
                                             ELSE DATEDIFF(MINUTE,
                                                CASE WHEN CAST(FirstScan AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(FirstScan AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                                CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                             )
                                        END
                                        - DATEDIFF(MINUTE, CAST(ShiftStart AS TIME), CAST(ShiftEnd AS TIME))
                                    ) / 60 AS VARCHAR(10)) + 'h ' +
                                    CAST(ABS(
                                        CASE WHEN DATEDIFF(MINUTE,
                                                CASE WHEN CAST(FirstScan AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(FirstScan AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                                CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                             ) < 0 THEN 0
                                             ELSE DATEDIFF(MINUTE,
                                                CASE WHEN CAST(FirstScan AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(FirstScan AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                                CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                             )
                                        END
                                        - DATEDIFF(MINUTE, CAST(ShiftStart AS TIME), CAST(ShiftEnd AS TIME))
                                    ) % 60 AS VARCHAR(10)) + 'm'
                                END
                            ELSE NULL END AS Variance,
                            CASE WHEN ShiftStart IS NOT NULL AND ShiftEnd IS NOT NULL THEN
                                CASE WHEN DATEDIFF(MINUTE,
                                        CASE WHEN CAST(FirstScan AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(FirstScan AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                        CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                     ) < 0 THEN 0
                                     ELSE DATEDIFF(MINUTE,
                                        CASE WHEN CAST(FirstScan AS TIME) > CAST(ShiftStart AS TIME) THEN CAST(FirstScan AS TIME) ELSE CAST(ShiftStart AS TIME) END,
                                        CASE WHEN CAST(EffectiveOut AS TIME) < CAST(ShiftEnd AS TIME) THEN CAST(EffectiveOut AS TIME) ELSE CAST(ShiftEnd AS TIME) END
                                     )
                                END
                                - DATEDIFF(MINUTE, CAST(ShiftStart AS TIME), CAST(ShiftEnd AS TIME))
                            ELSE NULL END AS VarianceMinutes,
                            HasShift, PayType,
                            CAST(
                                CASE WHEN ShiftStart IS NOT NULL AND ShiftEnd IS NOT NULL THEN
                                    DATEDIFF(MINUTE, CAST(ShiftStart AS TIME), CAST(ShiftEnd AS TIME)) / 60.0
                                    * CASE
                                        WHEN PayType = 'Hourly'  THEN ISNULL(HourlyRate, 0)
                                        WHEN PayType = 'Weekly'  THEN ISNULL(WeeklyRate, 0) / 40.0
                                        WHEN PayType = 'Monthly' THEN ISNULL(MonthlyRate, 0) / 176.0
                                        ELSE 0
                                      END
                                ELSE 0
                                END
                            AS DECIMAL(10,2)) AS Earnings
                        FROM cte
                        ORDER BY PersonName";
                    break;

                case "Shift":
                    // Per Shift — shift definitions (uses SiteCode via Employees link)
                    query = @"
                        SELECT 
                            s.ShiftName,
                            d.DepartmentName,
                            CONVERT(VARCHAR(5), s.StartTime, 108) AS ShiftStart,
                            CONVERT(VARCHAR(5), s.EndTime, 108) AS ShiftEnd,
                            CAST(DATEDIFF(MINUTE, CAST(s.StartTime AS TIME), CAST(s.EndTime AS TIME)) / 60.0 AS DECIMAL(10,2)) AS ShiftHours,
                            CASE WHEN s.IsActive = 1 THEN 'Active' ELSE 'Inactive' END AS Status
                        FROM Shifts s
                        INNER JOIN Departments d ON s.DepartmentID = d.DepartmentID
                        WHERE 1=1";
                    if (!string.IsNullOrEmpty(siteId))
                        query += @" AND s.SiteID IN (SELECT SiteID FROM Sites WHERE SiteCode = @SiteID)";
                    query += " ORDER BY d.DepartmentName, s.ShiftName";
                    break;

                case "Reader":
                    query = @"
                        SELECT DeviceIP, ReaderId, COUNT(*) AS TotalEvents,
                               MIN(Timestamp) AS FirstEvent, MAX(Timestamp) AS LastEvent
                        FROM ReaderEvents
                        WHERE Timestamp BETWEEN @FromDate AND @ToDate" + siteFilter + @"
                        GROUP BY DeviceIP, ReaderId ORDER BY TotalEvents DESC";
                    break;

                case "Emulated":
                    query = @"
                        SELECT PersonName, CardNumber, EventType, Timestamp, DeviceIP, ReaderId
                        FROM ReaderEvents
                        WHERE IsEmulated = 1 AND Timestamp BETWEEN @FromDate AND @ToDate" + siteFilter + @"
                        ORDER BY Timestamp DESC";
                    break;

                case "SyncFail":
                    query = @"
                        SELECT PersonName, EventType, Timestamp, DeviceIP, PayloadRaw
                        FROM ReaderEvents
                        WHERE PayloadRaw IS NOT NULL AND IsEmulated = 1
                          AND Timestamp BETWEEN @FromDate AND @ToDate" + siteFilter + @"
                        ORDER BY Timestamp DESC";
                    break;

                case "Hourly":
                    query = @"
                        SELECT DATEPART(HOUR, Timestamp) AS Hour, COUNT(*) AS Events
                        FROM ReaderEvents
                        WHERE Timestamp BETWEEN @FromDate AND @ToDate" + siteFilter + @"
                        GROUP BY DATEPART(HOUR, Timestamp) ORDER BY Hour";
                    break;

                case "TopUsers":
                    query = @"
                        SELECT TOP 50 PersonName, MAX(CardNumber) AS CardNumber, COUNT(*) AS Events
                        FROM ReaderEvents
                        WHERE Timestamp BETWEEN @FromDate AND @ToDate
                          AND PersonName IS NOT NULL AND PersonName <> ''" + siteFilter + @"
                        GROUP BY PersonName ORDER BY Events DESC";
                    break;

                case "Missing":
                    query = @"
                        SELECT PersonName, COUNT(*) AS Events
                        FROM ReaderEvents
                        WHERE Timestamp BETWEEN @FromDate AND @ToDate
                          AND (PersonName IS NULL OR PersonName = '')" + siteFilter + @"
                        GROUP BY PersonName ORDER BY Events DESC";
                    break;

                case "Rollup":
                    query = @"
                        SELECT SiteId, COUNT(*) AS TotalEvents,
                               COUNT(DISTINCT PersonName) AS UniquePersons,
                               MIN(Timestamp) AS FirstEvent, MAX(Timestamp) AS LastEvent
                        FROM ReaderEvents
                        WHERE Timestamp BETWEEN @FromDate AND @ToDate" + siteFilter + @"
                        GROUP BY SiteId ORDER BY TotalEvents DESC";
                    break;
            }

            return query;
        }

