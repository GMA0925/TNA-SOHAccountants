        // ============================
        // Excel Helper: Write Data Table
        // ============================

        private void WriteExcelDataTable(TextWriter sw, DataTable dt, string reportType, System.Collections.Generic.HashSet<string> excludeCols)
        {
            var displayCols = new System.Collections.Generic.List<DataColumn>();
            foreach (DataColumn col in dt.Columns)
            {
                if (!excludeCols.Contains(col.ColumnName))
                    displayCols.Add(col);
            }

            // Column Headers
            sw.WriteLine("<tr>");
            foreach (DataColumn col in displayCols)
            {
                string headerText = FormatColumnHeader(col.ColumnName);
                sw.WriteLine($"  <td class=\"header-cell\">{HttpUtility.HtmlEncode(headerText)}</td>");
            }
            sw.WriteLine("</tr>");

            // Data Rows
            int rowIndex = 0;
            foreach (DataRow row in dt.Rows)
            {
                string rowClass = rowIndex % 2 == 1 ? " class=\"alt-row\"" : "";
                sw.WriteLine($"<tr{rowClass}>");

                foreach (DataColumn col in displayCols)
                {
                    object val = row[col];
                    string cellClass = "data-cell";
                    string cellValue = "";

                    if (val == DBNull.Value || val == null)
                    {
                        cellValue = "";
                    }
                    else if (col.DataType == typeof(DateTime))
                    {
                        DateTime dtVal = (DateTime)val;
                        if (col.ColumnName.Contains("Date") || col.ColumnName == "WorkDate")
                        {
                            cellClass = "data-cell-date";
                            cellValue = dtVal.ToString("yyyy-MM-dd");
                        }
                        else
                        {
                            cellClass = "data-cell-time";
                            cellValue = dtVal.ToString("HH:mm:ss");
                        }
                    }
                    else if (col.DataType == typeof(decimal) || col.DataType == typeof(double))
                    {
                        bool isStillInsideRow = dt.Columns.Contains("Status") && row["Status"]?.ToString() == "Still Inside";
                        if ((col.ColumnName == "BasicPay" || col.ColumnName == "Earnings") && isStillInsideRow)
                        {
                            cellClass = "data-cell";
                            cellValue = "";
                        }
                        else
                        {
                            cellClass = (col.ColumnName == "BasicPay" || col.ColumnName == "Earnings") ? "data-cell-currency" : "data-cell-number";
                            cellValue = Convert.ToDecimal(val).ToString("0.00");
                        }
                    }
                    else
                    {
                        cellValue = val.ToString();

                        // Conditional formatting
                        if (col.ColumnName == "Status" && cellValue == "Still Inside")
                        {
                            cellClass = "warning-cell";
                        }
                        else if (col.ColumnName == "Variance")
                        {
                            bool hasShift = dt.Columns.Contains("HasShift") && row["HasShift"] != DBNull.Value && Convert.ToInt32(row["HasShift"]) == 1;
                            if (!hasShift)
                            {
                                cellValue = "N/A";
                                cellClass = "data-cell";
                            }
                            else if (dt.Columns.Contains("VarianceMinutes") && row["VarianceMinutes"] != DBNull.Value)
                            {
                                int varMin = Convert.ToInt32(row["VarianceMinutes"]);
                                cellClass = varMin > 0 ? "deficit-cell" : "surplus-cell";
                            }
                        }
                    }

                    sw.WriteLine($"  <td class=\"{cellClass}\">{HttpUtility.HtmlEncode(cellValue)}</td>");
                }

                sw.WriteLine("</tr>");
                rowIndex++;

                // Flush periodically for large datasets to avoid excessive memory usage
                if (rowIndex % 500 == 0)
                    sw.Flush();
            }
        }

        // ============================
        // Excel Helper: Daily Summary
        // ============================

        private void WriteExcelDailySummary(TextWriter sw, DataTable reportData)
        {
            sw.WriteLine("<tr><td colspan=\"12\">&nbsp;</td></tr>");
            sw.WriteLine("<tr><td colspan=\"12\" class=\"section-header\">📅 Daily Summary</td></tr>");

            sw.WriteLine("<tr>");
            sw.WriteLine("  <td class=\"header-cell\">Date</td>");
            sw.WriteLine("  <td class=\"header-cell\">Employees</td>");
            sw.WriteLine("  <td class=\"header-cell\">Clocked Out</td>");
            sw.WriteLine("  <td class=\"header-cell\">Still Inside</td>");
            sw.WriteLine("  <td class=\"header-cell\">Total Scans</td>");
            sw.WriteLine("  <td class=\"header-cell\">Avg Time Spent</td>");
            sw.WriteLine("</tr>");

            var dates = new System.Collections.Generic.SortedDictionary<string, int[]>();
            // int[0]=employees, int[1]=clockedOut, int[2]=stillInside, int[3]=totalScans, int[4]=totalMinutes

            foreach (DataRow row in reportData.Rows)
            {
                if (row["WorkDate"] == DBNull.Value) continue;

                string dateKey = Convert.ToDateTime(row["WorkDate"]).ToString("yyyy-MM-dd");
                if (!dates.ContainsKey(dateKey))
                    dates[dateKey] = new int[5];

                dates[dateKey][0]++;

                string status = row["Status"]?.ToString() ?? "";
                if (status == "Clocked Out")
                    dates[dateKey][1]++;
                else
                    dates[dateKey][2]++;

                if (row["Scans"] != DBNull.Value)
                    dates[dateKey][3] += Convert.ToInt32(row["Scans"]);

                // Parse TimeSpent "Xh Ym" to minutes
                string timeSpent = row["TimeSpent"]?.ToString() ?? "";
                dates[dateKey][4] += ParseTimeSpentToMinutes(timeSpent);
            }

            foreach (var kvp in dates)
            {
                int avgMinutes = kvp.Value[0] > 0 ? kvp.Value[4] / kvp.Value[0] : 0;
                string avgTime = $"{avgMinutes / 60}h {avgMinutes % 60}m";

                sw.WriteLine("<tr>");
                sw.WriteLine($"  <td class=\"data-cell-date\">{kvp.Key}</td>");
                sw.WriteLine($"  <td class=\"data-cell\">{kvp.Value[0]}</td>");
                sw.WriteLine($"  <td class=\"data-cell\">{kvp.Value[1]}</td>");
                sw.WriteLine($"  <td class=\"{(kvp.Value[2] > 0 ? "warning-cell" : "data-cell")}\">{kvp.Value[2]}</td>");
                sw.WriteLine($"  <td class=\"data-cell\">{kvp.Value[3]}</td>");
                sw.WriteLine($"  <td class=\"data-cell\">{avgTime}</td>");
                sw.WriteLine("</tr>");
            }
        }

