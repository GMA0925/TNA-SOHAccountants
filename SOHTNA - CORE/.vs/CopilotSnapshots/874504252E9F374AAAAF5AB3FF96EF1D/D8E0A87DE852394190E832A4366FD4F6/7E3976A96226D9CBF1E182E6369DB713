    public partial class Reports : System.Web.UI.Page
    {
        private string _connStr = Properties.Settings.Default.SQLCon;
        private bool _exportCompleted = false;

        protected override void Render(HtmlTextWriter writer)
        {
            if (_exportCompleted)
                return;
            base.Render(writer);
        }

        protected void Page_Load(object sender, EventArgs e)
        {
            if (Session["Username"] == null)
            {
                Response.Redirect("Login.aspx", false);
                Context.ApplicationInstance.CompleteRequest();
                return;
            }

            try
            {
                System.Reflection.Assembly assembly = System.Reflection.Assembly.GetExecutingAssembly();
                System.Reflection.AssemblyName assemblyName = assembly.GetName();
                lblVersion.Text = string.Format("v{0}", assemblyName.Version.ToString());
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Version Error: {ex.Message}");
            }

            if (!IsPostBack)
            {
                try
                {
                    txtFromDate.Text = DateTime.Today.ToString("yyyy-MM-dd");
                    txtToDate.Text = DateTime.Today.ToString("yyyy-MM-dd");
                    LoadSites();
                }
                catch (Exception ex)
                {
                    lblMessage.ForeColor = System.Drawing.Color.Red;
                    lblMessage.Text = "Error initializing page.";
                }
            }
        }

        private void LoadSites()
        {
            try
            {
                using (SqlConnection conn = new SqlConnection(_connStr))
                {
                    string query = "SELECT SiteID, SiteName, SiteCode FROM Sites WHERE IsActive = 1 ORDER BY SiteName";
                    using (SqlCommand cmd = new SqlCommand(query, conn))
                    {
                        cmd.CommandTimeout = 15;
                        using (SqlDataAdapter da = new SqlDataAdapter(cmd))
                        {
                            DataTable dt = new DataTable();
                            da.Fill(dt);

                            ddlSites.Items.Clear();
                            ddlSites.Items.Add(new System.Web.UI.WebControls.ListItem("Select a site", ""));
                            foreach (DataRow row in dt.Rows)
                            {
                                string siteName = row["SiteName"] != DBNull.Value ? row["SiteName"].ToString() : "";
                                string siteCode = row["SiteCode"] != DBNull.Value ? row["SiteCode"].ToString() : "";
                                string displayText = string.IsNullOrEmpty(siteCode) ? siteName : $"{siteName} ({siteCode})";
                                // Use SiteCode as the value since ReaderEvents.SiteId stores the site code, not numeric ID
                                string value = !string.IsNullOrEmpty(siteCode) ? siteCode : row["SiteID"].ToString();
                                ddlSites.Items.Add(new System.Web.UI.WebControls.ListItem(displayText, value));
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Error loading sites: {ex.Message}");
            }
        }

        // ============================
        // Quick Range
        // ============================

        protected void ddlQuickRange_SelectedIndexChanged(object sender, EventArgs e)
        {
            DateTime today = DateTime.Today;

            switch (ddlQuickRange.SelectedValue)
            {
                case "Today":
                    txtFromDate.Text = today.ToString("yyyy-MM-dd");
                    txtToDate.Text = today.ToString("yyyy-MM-dd");
                    break;
                case "Yesterday":
                    txtFromDate.Text = today.AddDays(-1).ToString("yyyy-MM-dd");
                    txtToDate.Text = today.AddDays(-1).ToString("yyyy-MM-dd");
                    break;
                case "Last3":
                    txtFromDate.Text = today.AddDays(-3).ToString("yyyy-MM-dd");
                    txtToDate.Text = today.ToString("yyyy-MM-dd");
                    break;
                case "LastWeek":
                    txtFromDate.Text = today.AddDays(-7).ToString("yyyy-MM-dd");
                    txtToDate.Text = today.ToString("yyyy-MM-dd");
                    break;
                case "ThisMonth":
                    txtFromDate.Text = new DateTime(today.Year, today.Month, 1).ToString("yyyy-MM-dd");
                    txtToDate.Text = today.ToString("yyyy-MM-dd");
                    break;
                case "LastMonth":
                    txtFromDate.Text = today.AddMonths(-1).ToString("yyyy-MM-dd");
                    txtToDate.Text = today.ToString("yyyy-MM-dd");
                    break;
                case "Last3Months":
                    txtFromDate.Text = today.AddMonths(-3).ToString("yyyy-MM-dd");
                    txtToDate.Text = today.ToString("yyyy-MM-dd");
                    break;
                case "Last6Months":
                    txtFromDate.Text = today.AddMonths(-6).ToString("yyyy-MM-dd");
                    txtToDate.Text = today.ToString("yyyy-MM-dd");
                    break;
            }
        }

