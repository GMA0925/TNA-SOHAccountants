        private static bool IsClientDisconnectError(HttpException ex)
        {
            // 0x800704CD = "An operation was attempted on a nonexistent network connection"
            // (the remote host / browser closed the connection)
            const int ERROR_CONNECTION_ABORT = unchecked((int)0x800704CD);
            return ex.ErrorCode == ERROR_CONNECTION_ABORT;
        }

        private int GetCommandTimeout(DateTime fromDate, DateTime toDate)
        {
            int days = (toDate - fromDate).Days;
            if (days > 180) return 120;
            if (days > 90) return 90;
            if (days > 30) return 60;
            return 30;
        }

        private string GetReportTitle(string reportType)
        {
            switch (reportType)
