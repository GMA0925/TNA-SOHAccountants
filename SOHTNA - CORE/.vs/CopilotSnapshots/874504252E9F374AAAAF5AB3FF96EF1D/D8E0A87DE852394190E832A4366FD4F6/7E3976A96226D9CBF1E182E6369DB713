        // ============================
        // Excel Helper: Enrich Report With Pay Columns
        // ============================

        private void EnrichReportWithPayColumns(DataTable reportData, DataTable payInfo, string reportType)
        {
            // Add pay columns to the main report data table
            if (!reportData.Columns.Contains("PayType"))
                reportData.Columns.Add("PayType", typeof(string));
            if (!reportData.Columns.Contains("Rate"))
                reportData.Columns.Add("Rate", typeof(string));
            if (!reportData.Columns.Contains("BasicPay"))
                reportData.Columns.Add("BasicPay", typeof(decimal));

            // Build lookup from payInfo keyed by PersonName + WorkDate (for Site) or PersonName (for Person)
            var payLookup = new System.Collections.Generic.Dictionary<string, DataRow>(StringComparer.OrdinalIgnoreCase);
            foreach (DataRow payRow in payInfo.Rows)
            {
                string person = payRow["PersonName"]?.ToString() ?? "";
                string key;
                if (reportType == "Site" && payInfo.Columns.Contains("WorkDate") && payRow["WorkDate"] != DBNull.Value)
                {
                    key = person + "|" + Convert.ToDateTime(payRow["WorkDate"]).ToString("yyyy-MM-dd");
                }
                else
                {
                    key = person;
                }
                if (!payLookup.ContainsKey(key))
                    payLookup[key] = payRow;
            }

            foreach (DataRow row in reportData.Rows)
            {
                string person = row["PersonName"]?.ToString() ?? "";
                string key;
                if (reportType == "Site" && reportData.Columns.Contains("WorkDate") && row["WorkDate"] != DBNull.Value)
                {
                    key = person + "|" + Convert.ToDateTime(row["WorkDate"]).ToString("yyyy-MM-dd");
                }
                else
                {
                    key = person;
                }

                DataRow payRow;
                if (!payLookup.TryGetValue(key, out payRow))
                {
                    // Try person-only fallback
                    payLookup.TryGetValue(person, out payRow);
                }

                if (payRow != null)
                {
                    string payType = payRow["PayType"]?.ToString() ?? "";
                    decimal hourlyRate = payInfo.Columns.Contains("HourlyRate") && payRow["HourlyRate"] != DBNull.Value ? Convert.ToDecimal(payRow["HourlyRate"]) : 0;
                    decimal weeklyRate = payInfo.Columns.Contains("WeeklyRate") && payRow["WeeklyRate"] != DBNull.Value ? Convert.ToDecimal(payRow["WeeklyRate"]) : 0;
                    decimal monthlyRate = payInfo.Columns.Contains("MonthlyRate") && payRow["MonthlyRate"] != DBNull.Value ? Convert.ToDecimal(payRow["MonthlyRate"]) : 0;
                    decimal actualHrs = payInfo.Columns.Contains("ActualHours") && payRow["ActualHours"] != DBNull.Value ? Convert.ToDecimal(payRow["ActualHours"]) : 0;

                    row["PayType"] = payType;

                    switch (payType.ToLower())
                    {
                        case "hourly":
                            row["Rate"] = hourlyRate.ToString("0.00") + "/hr";
                            row["BasicPay"] = actualHrs * hourlyRate;
                            break;
                        case "weekly":
                            row["Rate"] = weeklyRate.ToString("0.00") + "/wk";
                            row["BasicPay"] = weeklyRate > 0 ? weeklyRate / 5m : 0;
                            break;
                        default:
                            row["Rate"] = monthlyRate > 0 ? monthlyRate.ToString("0.00") + "/mo" : "";
                            row["BasicPay"] = monthlyRate > 0 ? monthlyRate / 22m : 0;
                            break;
                    }
                }
                else
                {
                    row["PayType"] = "";
                    row["Rate"] = "";
                    row["BasicPay"] = 0m;
                }
            }
        }

        // ============================
        // Excel Helper: Get Pay Info
        // ============================

        private DataTable GetPayInformation(string siteId, DateTime fromDate, DateTime toDate)
        {
            try
            {
                using (SqlConnection conn = new SqlConnection(_connStr))
                {
                    string siteFilter = !string.IsNullOrEmpty(siteId)
                        ? " AND CAST(r.SiteId AS NVARCHAR(MAX)) = @SiteID"
                        : "";

                    string query = @"
SELECT 
    r.PersonName,
    MAX(r.CardNumber) AS EmployeeCode,
    MAX(d.DepartmentName) AS Department,
    MAX(e.PayType) AS PayType,
    MAX(e.HourlyRate) AS HourlyRate,
    MAX(e.WeeklyRate) AS WeeklyRate,
    MAX(e.MonthlyRate) AS MonthlyRate,
    MAX(sh.ShiftName) AS ShiftName,
    CONVERT(VARCHAR(5), MAX(sh.StartTime), 108) AS ShiftStart,
    CONVERT(VARCHAR(5), MAX(sh.EndTime), 108) AS ShiftEnd,
    CAST(CASE WHEN MAX(sh.StartTime) IS NOT NULL AND MAX(sh.EndTime) IS NOT NULL
         THEN DATEDIFF(MINUTE, CAST(MAX(sh.StartTime) AS TIME), CAST(MAX(sh.EndTime) AS TIME)) / 60.0
         ELSE 0 END AS DECIMAL(10,2)) AS DailyRequiredHours,
    CONVERT(DATE, r.Timestamp) AS WorkDate,
    MIN(r.Timestamp) AS ClockIn,
    CASE WHEN MIN(r.Timestamp) = MAX(r.Timestamp) THEN NULL ELSE MAX(r.Timestamp) END AS ClockOut,
    CASE WHEN MIN(r.Timestamp) = MAX(r.Timestamp) THEN 'Still Inside' ELSE 'Clocked Out' END AS Status,
    CAST(CASE 
        WHEN MIN(r.Timestamp) = MAX(r.Timestamp) THEN 0
        WHEN MAX(sh.StartTime) IS NOT NULL
            THEN DATEDIFF(MINUTE, CAST(MAX(sh.StartTime) AS TIME), CAST(MAX(r.Timestamp) AS TIME)) / 60.0
        ELSE DATEDIFF(MINUTE, MIN(r.Timestamp), MAX(r.Timestamp)) / 60.0
    END AS DECIMAL(10,2)) AS ActualHours,
    CAST(CASE 
        WHEN MAX(sh.StartTime) IS NOT NULL AND MAX(sh.EndTime) IS NOT NULL THEN
            CASE WHEN MIN(r.Timestamp) = MAX(r.Timestamp) THEN 0
            ELSE 
                (DATEDIFF(MINUTE, CAST(MAX(sh.StartTime) AS TIME), CAST(MAX(r.Timestamp) AS TIME)) / 60.0)
                - (DATEDIFF(MINUTE, CAST(MAX(sh.StartTime) AS TIME), CAST(MAX(sh.EndTime) AS TIME)) / 60.0)
            END
        ELSE 0
    END AS DECIMAL(10,2)) AS OvertimeHours
FROM ReaderEvents r
LEFT JOIN Employees e ON r.PersonName = e.NameSurname 
    AND CAST(r.SiteId AS NVARCHAR(MAX)) = CAST(e.SiteID AS NVARCHAR(MAX))
LEFT JOIN Shifts sh ON sh.EmployeeID = e.EmployeeID AND sh.IsActive = 1
LEFT JOIN Departments d ON e.DepartmentID = d.DepartmentID
WHERE r.Timestamp BETWEEN @FromDate AND @ToDate
  AND r.PersonName IS NOT NULL AND r.PersonName <> ''" + siteFilter.Replace("SiteId", "r.SiteId") + @"
GROUP BY r.PersonName, CONVERT(DATE, r.Timestamp)
ORDER BY r.PersonName, WorkDate";

            using (SqlCommand cmd = new SqlCommand(query, conn))
            {
                cmd.Parameters.AddWithValue("@FromDate", fromDate.Date);
                cmd.Parameters.AddWithValue("@ToDate", toDate.Date.AddDays(1).AddSeconds(-1));
                if (!string.IsNullOrEmpty(siteId))
                    cmd.Parameters.AddWithValue("@SiteID", siteId);
                cmd.CommandTimeout = GetCommandTimeout(fromDate, toDate);

                using (SqlDataAdapter da = new SqlDataAdapter(cmd))
                {
                    DataTable dt = new DataTable();
                    da.Fill(dt);
                    return dt;
                }
            }
        }
    }
    catch (Exception ex)
    {
        System.Diagnostics.Debug.WriteLine($"GetPayInformation error: {ex.Message}");
        return null;
    }
}

        // ============================
        // ClosedXML Helper: Set Column Widths
        // ============================

        private void SetColumnWidths(IXLWorksheet ws)
        {
            // AdjustToContents() in ClosedXML 0.97.0 throws FileNotFoundException
            // due to a missing font-metrics resource. Use fixed widths per column type instead.
            foreach (IXLColumn col in ws.ColumnsUsed())
            {
                // Peek at the header cell to infer a sensible width
                string header = ws.Cell(1, col.ColumnNumber()).GetString();
                if (string.IsNullOrEmpty(header))
                    header = col.FirstCellUsed()?.GetString() ?? "";

                int width;
                if (header.Contains("Name") || header.Contains("Person"))
                    width = 28;
                else if (header.Contains("Date") || header.Contains("Time") || header.Contains("Scan") || header.Contains("Clock"))
                    width = 20;
                else if (header.Contains("Variance") || header.Contains("Required") || header.Contains("Spent") || header.Contains("Shift"))
                    width = 18;
                else if (header.Contains("Pay") || header.Contains("Earn") || header.Contains("Rate"))
                    width = 16;
                else if (header.Contains("Status"))
                    width = 16;
                else
                    width = 14;

                col.Width = width;
            }
        }

        // ============================
        // Excel Helper: Sanitize Sheet Name
        // ============================

        private string SanitizeSheetName(string name)
        {
            if (string.IsNullOrEmpty(name)) return "Unknown";
            // Excel sheet names: max 31 chars, no special chars: \ / * ? : [ ]
            string safe = name;
            foreach (char c in new[] { '\\', '/', '*', '?', ':', '[', ']' })
                safe = safe.Replace(c, '_');
            if (safe.Length > 31)
                safe = safe.Substring(0, 31);
            return safe.Trim();
        }

