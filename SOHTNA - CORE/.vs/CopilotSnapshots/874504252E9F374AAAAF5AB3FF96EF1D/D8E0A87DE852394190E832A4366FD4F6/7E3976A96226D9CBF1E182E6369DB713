        // ============================
        // ClosedXML Helper: Write Daily Summary
        // ============================

        private int WriteXlDailySummary(IXLWorksheet ws, int startRow, DataTable reportData)
        {
            int row = startRow;

            // Section header
            var secHeader = ws.Cell(row, 1);
            secHeader.Value = "Daily Summary";
            secHeader.Style.Font.Bold = true;
            secHeader.Style.Fill.BackgroundColor = XLColor.FromHtml("#E8F0FE");
            row++;

            // Column headers
            string[] headers = { "Date", "Employees", "Clocked Out", "Still Inside", "Total Scans", "Avg Time Spent" };
            for (int c = 0; c < headers.Length; c++)
            {
                var cell = ws.Cell(row, c + 1);
                cell.Value = headers[c];
                cell.Style.Font.Bold = true;
                cell.Style.Fill.BackgroundColor = XLColor.FromHtml("#0078D4");
                cell.Style.Font.FontColor = XLColor.White;
            }
            row++;

            var dates = new System.Collections.Generic.SortedDictionary<string, int[]>();
            foreach (DataRow dr in reportData.Rows)
            {
                if (dr["WorkDate"] == DBNull.Value) continue;
                string dateKey = Convert.ToDateTime(dr["WorkDate"]).ToString("yyyy-MM-dd");
                if (!dates.ContainsKey(dateKey)) dates[dateKey] = new int[5];
                dates[dateKey][0]++;
                string status = dr["Status"]?.ToString() ?? "";
                if (status == "Clocked Out") dates[dateKey][1]++;
                else dates[dateKey][2]++;
                if (dr["Scans"] != DBNull.Value) dates[dateKey][3] += Convert.ToInt32(dr["Scans"]);
                dates[dateKey][4] += ParseTimeSpentToMinutes(dr["TimeSpent"]?.ToString() ?? "");
            }

            bool alt = false;
            foreach (var kvp in dates)
            {
                int avgMin = kvp.Value[0] > 0 ? kvp.Value[4] / kvp.Value[0] : 0;
                ws.Cell(row, 1).Value = kvp.Key;
                ws.Cell(row, 1).Style.DateFormat.Format = "yyyy-MM-dd";
                ws.Cell(row, 2).Value = kvp.Value[0];
                ws.Cell(row, 3).Value = kvp.Value[1];
                ws.Cell(row, 4).Value = kvp.Value[2];
                if (kvp.Value[2] > 0) ws.Cell(row, 4).Style.Font.FontColor = XLColor.OrangeRed;
                ws.Cell(row, 5).Value = kvp.Value[3];
                ws.Cell(row, 6).Value = $"{avgMin / 60}h {avgMin % 60}m";
                if (alt)
                    ws.Row(row).Style.Fill.BackgroundColor = XLColor.FromHtml("#F9F9F9");
                alt = !alt;
                row++;
            }

            row++; // blank row after summary
            return row;
        }

