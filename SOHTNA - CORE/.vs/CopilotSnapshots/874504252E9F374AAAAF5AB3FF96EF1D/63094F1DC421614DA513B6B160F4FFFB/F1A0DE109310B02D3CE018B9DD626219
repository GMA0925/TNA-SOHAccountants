        /// <summary>
        /// Bulk update all Navigation-category permissions for the selected role
        /// </summary>
        private void BulkUpdateNavPermissions(bool allowed)
        {
            string selectedRole = ddlPermissionRole.SelectedValue;
            if (string.IsNullOrEmpty(selectedRole))
            {
                ShowMessage("Please select a role first.", "warning");
                return;
            }

            try
            {
                using (SqlConnection conn = new SqlConnection(_connStr))
                {
                    conn.Open();

                    string query = @"
                        UPDATE RolePermissions 
                        SET IsAllowed = @IsAllowed, ModifiedDate = GETDATE()
                        WHERE RoleName = @RoleName 
                        AND ISNULL(Category, 'Navigation') = 'Navigation'";

                    using (SqlCommand cmd = new SqlCommand(query, conn))
                    {
                        cmd.Parameters.AddWithValue("@IsAllowed", allowed);
                        cmd.Parameters.AddWithValue("@RoleName", selectedRole);
                        cmd.CommandTimeout = 15;
                        cmd.ExecuteNonQuery();
                    }
                }

                string categoryFilter = ddlPermissionCategory.SelectedValue;
                LoadPermissionsGrid(selectedRole, categoryFilter);
                string action = allowed ? "granted" : "revoked";
                ShowMessage($"All navigation menu access {action} for role '{selectedRole}'.", "success");
            }
            catch (Exception ex)
            {
                ShowMessage("Error updating permissions: " + ex.Message, "error");
            }
        }

        /// <summary>
        /// Load permission grid for a specific role, optionally filtered by category
        /// </summary>
        private void LoadPermissionsGrid(string roleName, string categoryFilter = "")
        {
            try
            {
                using (SqlConnection conn = new SqlConnection(_connStr))
                {
                    string query = @"
                        SELECT PermissionID, FeatureKey, FeatureLabel, 
                               ISNULL(Category, 'Navigation') AS Category, IsAllowed 
                        FROM RolePermissions 
                        WHERE RoleName = @RoleName";

                    if (!string.IsNullOrEmpty(categoryFilter))
                        query += " AND ISNULL(Category, 'Navigation') = @Category";

                    query += " ORDER BY ISNULL(Category, 'Navigation'), FeatureLabel";

                    SqlCommand cmd = new SqlCommand(query, conn);
                    cmd.Parameters.AddWithValue("@RoleName", roleName);
                    if (!string.IsNullOrEmpty(categoryFilter))
                        cmd.Parameters.AddWithValue("@Category", categoryFilter);
                    cmd.CommandTimeout = 15;

                    SqlDataAdapter da = new SqlDataAdapter(cmd);
                    DataTable dt = new DataTable();
                    da.Fill(dt);

                    gvPermissions.DataSource = dt;
                    gvPermissions.DataBind();
                }
            }
            catch (Exception ex)
            {
                ShowMessage("Error loading permissions: " + ex.Message, "error");
            }
        }

