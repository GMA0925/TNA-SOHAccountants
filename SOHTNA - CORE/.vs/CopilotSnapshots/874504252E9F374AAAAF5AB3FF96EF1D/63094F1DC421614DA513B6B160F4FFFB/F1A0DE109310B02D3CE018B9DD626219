        /// <summary>
        /// Display message to user using the global popup notification system
        /// </summary>
        private void ShowMessage(string message, string type)
        {
            string title;
            switch (type)
            {
                case "success": title = "Success"; break;
                case "error": title = "Error"; break;
                case "warning": title = "Warning"; break;
                default: title = "Information"; break;
            }

            string escapedMessage = System.Web.HttpUtility.JavaScriptStringEncode(message);
            string escapedTitle = System.Web.HttpUtility.JavaScriptStringEncode(title);

            // Simple immediate call — the script tag is rendered after the JS file include
            // so showNotification is guaranteed to be defined by the time this executes.
            string script = string.Format(
                "showNotification('{0}', '{1}', '{2}', 4000);",
                System.Web.HttpUtility.JavaScriptStringEncode(type),
                escapedTitle,
                escapedMessage);

            string scriptKey = "showPopup_" + Guid.NewGuid().ToString("N");

            // Use ScriptManager if available (e.g. inside UpdatePanel), otherwise fall back to ClientScript
            var scriptManager = ScriptManager.GetCurrent(this.Page);
            if (scriptManager != null)
            {
                ScriptManager.RegisterStartupScript(this, GetType(), scriptKey, script, true);
            }
            else
            {
                if (!ClientScript.IsStartupScriptRegistered(GetType(), scriptKey))
                {
                    ClientScript.RegisterStartupScript(GetType(), scriptKey, script, true);
                }
            }
        }
