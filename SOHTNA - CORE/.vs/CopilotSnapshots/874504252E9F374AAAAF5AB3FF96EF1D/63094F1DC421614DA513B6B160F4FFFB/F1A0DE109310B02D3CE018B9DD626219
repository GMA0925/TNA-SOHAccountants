        /// <summary>
        /// Initialize the RolePermissions table and seed default permissions
        /// </summary>
        protected void btnInitPermissions_Click(object sender, EventArgs e)
        {
            try
            {
                using (SqlConnection conn = new SqlConnection(_connStr))
                {
                    conn.Open();

                    // Create RolePermissions table if not exists
                    string createTable = @"
                        IF NOT EXISTS (SELECT * FROM sys.tables WHERE name = 'RolePermissions')
                        BEGIN
                            CREATE TABLE RolePermissions (
                                PermissionID INT IDENTITY(1,1) PRIMARY KEY,
                                RoleName NVARCHAR(50) NOT NULL,
                                FeatureKey NVARCHAR(100) NOT NULL,
                                FeatureLabel NVARCHAR(150) NOT NULL,
                                Category NVARCHAR(50) NOT NULL DEFAULT 'Navigation',
                                IsAllowed BIT NOT NULL DEFAULT 0,
                                ModifiedDate DATETIME DEFAULT GETDATE(),
                                CONSTRAINT UQ_Role_Feature UNIQUE (RoleName, FeatureKey)
                            );
                        END
                        ELSE
                        BEGIN
                            IF NOT EXISTS (SELECT * FROM sys.columns WHERE object_id = OBJECT_ID('RolePermissions') AND name = 'Category')
                            BEGIN
                                ALTER TABLE RolePermissions ADD Category NVARCHAR(50) NOT NULL DEFAULT 'Navigation';
                            END
                        END";

                    using (SqlCommand cmd = new SqlCommand(createTable, conn))
                    {
                        cmd.CommandTimeout = 30;
                        cmd.ExecuteNonQuery();
                    }

                    // Create UserNavPermissions table if not exists
                    string createUserNavTable = @"
                        IF NOT EXISTS (SELECT * FROM sys.tables WHERE name = 'UserNavPermissions')
                        BEGIN
                            CREATE TABLE UserNavPermissions (
                                ID INT IDENTITY(1,1) PRIMARY KEY,
                                Username NVARCHAR(100) NOT NULL,
                                FeatureKey NVARCHAR(100) NOT NULL,
                                FeatureLabel NVARCHAR(150) NOT NULL,
                                IsAllowed BIT NOT NULL DEFAULT 0,
                                ModifiedDate DATETIME DEFAULT GETDATE(),
                                CONSTRAINT UQ_User_Feature UNIQUE (Username, FeatureKey)
                            );
                        END";

                    using (SqlCommand cmd = new SqlCommand(createUserNavTable, conn))
                    {
                        cmd.CommandTimeout = 30;
                        cmd.ExecuteNonQuery();
                    }

                    // Define all features/buttons in the system: { FeatureKey, FeatureLabel, Category }
                    string[][] features = new string[][]
                    {
                        // Navigation Menu buttons
                        new[] { "Dashboard", "Dashboard", "Navigation" },
                        new[] { "UserManagement", "User Management", "Navigation" },
                        new[] { "ConfigTools", "Config Tools", "Navigation" },
                        new[] { "SyncLog", "Sync Log", "Navigation" },
                        new[] { "Employees", "Employees", "Navigation" },
                        new[] { "ShiftManagement", "Shift Management", "Navigation" },
                        new[] { "Reports", "Reports", "Navigation" },
                        new[] { "Payroll", "Payroll", "Navigation" },
                        new[] { "Attendance", "Attendance Tracking", "Navigation" },
                        new[] { "Leave", "Leave Management", "Navigation" },
                        new[] { "Timesheet", "Timesheet", "Navigation" },
                        new[] { "Compliance", "Compliance & Auditing", "Navigation" },
                        new[] { "Settings", "System Settings", "Navigation" },
                        new[] { "Notifications", "Notifications", "Navigation" },
                        new[] { "Profile", "My Profile", "Navigation" },
                        // Page-level action buttons
                        new[] { "ExportExcel", "Export to Excel", "Action" },
                        new[] { "ExportPDF", "Export to PDF", "Action" },
                        new[] { "BackupDB", "Backup Database", "Action" },
                        new[] { "RestoreDB", "Restore Database", "Action" },
                        new[] { "ClearCache", "Clear Cache", "Action" },
                        new[] { "ResetLogs", "Reset Logs", "Action" }
                    };

                    // Default permission profiles
                    // Admin = full access, Manager = most features, User = basic features
                    string[] roles = new[] { "Admin", "Manager", "User" };

                    string[] adminOnly = new[] { "UserManagement", "ConfigTools", "SyncLog", "Settings", "BackupDB", "RestoreDB", "ClearCache", "ResetLogs" };
                    string[] managerAndAbove = new[] { "Employees", "ShiftManagement", "Reports", "Compliance", "ExportExcel", "ExportPDF" };
                    string[] allUsers = new[] { "Dashboard", "Payroll", "Attendance", "Leave", "Timesheet", "Notifications", "Profile" };

                    foreach (string role in roles)
                    {
                        foreach (string[] feature in features)
                        {
                            string featureKey = feature[0];
                            string featureLabel = feature[1];
                            string category = feature[2];

                            bool allowed = false;
                            if (role == "Admin")
                                allowed = true;
                            else if (role == "Manager")
                                allowed = Array.IndexOf(managerAndAbove, featureKey) >= 0 || Array.IndexOf(allUsers, featureKey) >= 0;
                            else // User
                                allowed = Array.IndexOf(allUsers, featureKey) >= 0;

                            string merge = @"
                                MERGE INTO RolePermissions AS target
                                USING (SELECT @RoleName AS RoleName, @FeatureKey AS FeatureKey) AS source
                                ON target.RoleName = source.RoleName AND target.FeatureKey = source.FeatureKey
                                WHEN NOT MATCHED THEN
                                    INSERT (RoleName, FeatureKey, FeatureLabel, Category, IsAllowed, ModifiedDate)
                                    VALUES (@RoleName, @FeatureKey, @FeatureLabel, @Category, @IsAllowed, GETDATE())
                                WHEN MATCHED THEN
                                    UPDATE SET Category = @Category, FeatureLabel = @FeatureLabel, ModifiedDate = GETDATE();";

                            using (SqlCommand cmd = new SqlCommand(merge, conn))
                            {
                                cmd.Parameters.AddWithValue("@RoleName", role);
                                cmd.Parameters.AddWithValue("@FeatureKey", featureKey);
                                cmd.Parameters.AddWithValue("@FeatureLabel", featureLabel);
                                cmd.Parameters.AddWithValue("@Category", category);
                                cmd.Parameters.AddWithValue("@IsAllowed", allowed);
                                cmd.CommandTimeout = 15;
                                cmd.ExecuteNonQuery();
                            }
                        }
                    }
                }

                LoadPermissionRoles();
                LoadUserNavList();
                ShowMessage("Permissions tables initialized (Role + User-level). Default role profiles seeded.", "success");
            }
            catch (Exception ex)
            {
                ShowMessage("Error initializing permissions: " + ex.Message, "error");
            }
        }

