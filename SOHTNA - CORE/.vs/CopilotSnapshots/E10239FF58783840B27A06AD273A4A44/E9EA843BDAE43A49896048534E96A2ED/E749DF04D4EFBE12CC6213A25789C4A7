        protected void gvReports_RowCommand(object sender, GridViewCommandEventArgs e)
        {
            try
            {
                int reportId = Convert.ToInt32(e.CommandArgument);

                if (e.CommandName == "Download")
                {
                    // Implement download logic
                }
                else if (e.CommandName == "Delete")
                {
                    using (SqlConnection conn = new SqlConnection(_connStr))
                    {
                        string query = "DELETE FROM ComplianceReport WHERE ReportID = @ReportID";
                        SqlCommand cmd = new SqlCommand(query, conn);
                        cmd.Parameters.AddWithValue("@ReportID", reportId);
                        conn.Open();
                        cmd.ExecuteNonQuery();
                    }
                    LoadGeneratedReports();
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Error in row command: {ex.Message}");
            }
        }

