                LoadGeneralSettings();
                LoadAttendanceSettings();
                LoadLeaveSettings();
                LoadEmailSettings();
                LoadSecuritySettings();
                LoadNotificationSettings();
                LoadFeatureToggles();
            }
        }

        #region Load Settings Methods

        private void LoadGeneralSettings()
        {
            try
            {
                using (SqlConnection conn = new SqlConnection(_connStr))
                {
                    string query = @"
                        SELECT SettingKey, SettingValue 
                        FROM SystemSettings 
                        WHERE Category = 'General' AND IsActive = 1";

                    SqlCommand cmd = new SqlCommand(query, conn);
                    SqlDataAdapter da = new SqlDataAdapter(cmd);
                    DataTable dt = new DataTable();
                    da.Fill(dt);

                    foreach (DataRow row in dt.Rows)
                    {
                        string key = row["SettingKey"].ToString();
                        string value = row["SettingValue"].ToString();

                        switch (key)
                        {
                            case "CompanyName":
                                txtCompanyName.Text = value;
                                break;
                            case "CompanyEmail":
                                txtCompanyEmail.Text = value;
                                break;
                            case "CompanyPhone":
                                txtCompanyPhone.Text = value;
                                break;
                            case "TimeZone":
                                ddlTimeZone.SelectedValue = value;
                                break;
                            case "Currency":
                                ddlCurrency.SelectedValue = value;
                                break;
                            case "DateFormat":
                                ddlDateFormat.SelectedValue = value;
                                break;
                            case "MaintenanceMode":
                                chkMaintenanceMode.Checked = value.ToLower() == "true";
                                break;
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                ShowMessage("Error loading general settings: " + ex.Message, "error");
            }
        }

        private void LoadAttendanceSettings()
        {
            try
            {
                using (SqlConnection conn = new SqlConnection(_connStr))
                {
                    string query = @"
                        SELECT * FROM AttendanceSettings ORDER BY AttendanceSettingID DESC";

                    SqlCommand cmd = new SqlCommand(query, conn);
                    conn.Open();
                    using (SqlDataReader reader = cmd.ExecuteReader())
                    {
                        if (reader.Read())
                        {
                            txtLateArrivalThreshold.Text = reader["LateArrivalThreshold"].ToString();
                            txtEarlyDepartureThreshold.Text = reader["EarlyDepartureThreshold"].ToString();
                            txtGracePeriod.Text = reader["GracePeriodMinutes"].ToString();
                            txtMinAttendance.Text = reader["MinimumAttendancePercentage"].ToString();
                            chkAutoCheckOut.Checked = (bool)reader["AllowAutoCheckOut"];
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                ShowMessage("Error loading attendance settings: " + ex.Message, "error");
            }
        }

        private void LoadLeaveSettings()
        {
            try
            {
                using (SqlConnection conn = new SqlConnection(_connStr))
                {
                    string query = @"
                        SELECT lt.LeaveTypeID, lt.LeaveTypeName, ls.AllocationPerYear, ls.EncashableLeaves
                        FROM LeaveTypes lt
                        LEFT JOIN LeaveSettings ls ON lt.LeaveTypeID = ls.LeaveTypeID
                        WHERE lt.IsActive = 1
                        ORDER BY lt.LeaveTypeName";

                    SqlCommand cmd = new SqlCommand(query, conn);
                    SqlDataAdapter da = new SqlDataAdapter(cmd);
                    DataTable dt = new DataTable();
                    da.Fill(dt);

                    gvLeaveTypes.DataSource = dt;
                    gvLeaveTypes.DataBind();
                }
            }
            catch (Exception ex)
            {
                ShowMessage("Error loading leave settings: " + ex.Message, "error");
            }
        }

