        #region Helper Methods

        private void SaveSetting(SqlConnection conn, string key, string value)
        {
            string query = @"
                IF EXISTS (SELECT 1 FROM SystemSettings WHERE SettingKey = @SettingKey)
                    UPDATE SystemSettings SET SettingValue = @SettingValue, ModifiedDate = GETDATE() WHERE SettingKey = @SettingKey
                ELSE
                    INSERT INTO SystemSettings (SettingKey, SettingValue, SettingType, Category, IsActive) 
                    VALUES (@SettingKey, @SettingValue, 'String', 'General', 1)";

            SqlCommand cmd = new SqlCommand(query, conn);
            cmd.Parameters.AddWithValue("@SettingKey", key);
            cmd.Parameters.AddWithValue("@SettingValue", value);
            cmd.ExecuteNonQuery();
        }

        private void ShowMessage(string message, string type)
        {
            lblMessage.Text = message;
            lblMessage.Visible = true;
            lblMessage.CssClass = type == "success" ? "success-message" : "error-message";
        }

