        private DataTable GetPairedClockEvents(string personName, string siteId, DateTime fromDate, DateTime toDate)
        {
            DataTable dtResult = new DataTable();
            dtResult.Columns.Add("EventDate", typeof(DateTime));
            dtResult.Columns.Add("ClockIn", typeof(string));
            dtResult.Columns.Add("ClockOut", typeof(string));
            dtResult.Columns.Add("Duration", typeof(string));
            dtResult.Columns.Add("ReaderName", typeof(string));

            using (SqlConnection conn = new SqlConnection(ConnStr))
            {
                string sql = @"
                    SELECT
                        CAST(Timestamp AS DATE) AS EventDate,
                        Timestamp,
                        Direction,
                        ISNULL(ReaderId, '-') AS ReaderName
                    FROM   ReaderEvents
                    WHERE  UPPER(PersonName) = UPPER(@Name)
                      AND  SiteId   = @SiteId
                      AND  CAST(Timestamp AS DATE) >= @FromDate
                      AND  CAST(Timestamp AS DATE) <= @ToDate
                    ORDER  BY Timestamp ASC";

                using (SqlCommand cmd = new SqlCommand(sql, conn))
                {
                    cmd.Parameters.AddWithValue("@Name",     personName);
                    cmd.Parameters.AddWithValue("@SiteId",   siteId);
                    cmd.Parameters.AddWithValue("@FromDate", fromDate.Date);
                    cmd.Parameters.AddWithValue("@ToDate",   toDate.Date);

                    SqlDataAdapter da = new SqlDataAdapter(cmd);
                    DataTable dtRaw = new DataTable();
                    da.Fill(dtRaw);

                    // Pair IN/OUT events
                    DateTime? lastInTime = null;
                    string lastReader = "-";

                    foreach (DataRow row in dtRaw.Rows)
                    {
                        DateTime ts = Convert.ToDateTime(row["Timestamp"]);
                        int direction = row["Direction"] != DBNull.Value ? Convert.ToInt32(row["Direction"]) : -1;
                        string reader = row["ReaderName"].ToString();

                        if (direction == 0) // IN
                        {
                            lastInTime = ts;
                            lastReader = reader;
                        }
                        else if (direction == 1 && lastInTime.HasValue) // OUT with matching IN
                        {
                            TimeSpan dur = ts - lastInTime.Value;
                            DataRow newRow = dtResult.NewRow();
                            newRow["EventDate"]  = ts.Date;
                            newRow["ClockIn"]    = lastInTime.Value.ToString("HH:mm");
                            newRow["ClockOut"]   = ts.ToString("HH:mm");
                            newRow["Duration"]   = string.Format("{0}h {1}m", (int)dur.TotalHours, dur.Minutes);
                            newRow["ReaderName"] = lastReader;
                            dtResult.Rows.Add(newRow);

                            lastInTime = null;
                            lastReader = "-";
                        }
                        else if (direction == 1 && !lastInTime.HasValue) // OUT without matching IN
                        {
                            DataRow newRow = dtResult.NewRow();
                            newRow["EventDate"]  = ts.Date;
                            newRow["ClockIn"]    = "-";
                            newRow["ClockOut"]   = ts.ToString("HH:mm");
                            newRow["Duration"]   = "-";
                            newRow["ReaderName"] = reader;
                            dtResult.Rows.Add(newRow);
                        }
                    }

                    // Unmatched IN at end
                    if (lastInTime.HasValue)
                    {
                        DataRow newRow = dtResult.NewRow();
                        newRow["EventDate"]  = lastInTime.Value.Date;
                        newRow["ClockIn"]    = lastInTime.Value.ToString("HH:mm");
                        newRow["ClockOut"]   = "-";
                        newRow["Duration"]   = "-";
                        newRow["ReaderName"] = lastReader;
                        dtResult.Rows.Add(newRow);
                    }
                }
            }

            // Sort newest first
            dtResult.DefaultView.Sort = "EventDate DESC";
            return dtResult.DefaultView.ToTable();
        }

