        // ?? Export CSV ????????????????????????????????????????????????????????
        protected void btnExportMyEvents_Click(object sender, EventArgs e)
        {
            if (string.IsNullOrWhiteSpace(SessionNameSurname)) return;

            try
            {
                DataTable dtPaired = GetPairedClockEvents(SessionNameSurname, SessionSiteId,
                    DateTime.Today.AddDays(-90), DateTime.Today);

                StringBuilder sb = new StringBuilder();
                sb.AppendLine("Date,Clock In,Clock Out,Duration,Reader");

                foreach (DataRow row in dtPaired.Rows)
                {
                    sb.AppendFormat("{0},{1},{2},{3},{4}\r\n",
                        row["EventDate"] != DBNull.Value ? Convert.ToDateTime(row["EventDate"]).ToString("yyyy-MM-dd") : "",
                        CsvEscape(row["ClockIn"].ToString()),
                        CsvEscape(row["ClockOut"].ToString()),
                        CsvEscape(row["Duration"].ToString()),
                        CsvEscape(row["ReaderName"].ToString()));
                }

                Response.Clear();
                Response.ContentType = "text/csv";
                Response.AddHeader("Content-Disposition",
                    string.Format("attachment; filename=MyClockEvents_{0}.csv", DateTime.Today.ToString("yyyyMMdd")));
                Response.Write(sb.ToString());
                Response.End();
            }
            catch (Exception ex)
            {
                ShowMessage("error", "Could not export events: " + ex.Message);
            }
        }

