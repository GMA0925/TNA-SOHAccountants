        private static string SafeStr(SqlDataReader r, string col)
        {
            try { return r[col] == DBNull.Value ? "" : r[col].ToString(); }
            catch { return ""; }
        }

        private static string CsvEscape(string val)
        {
            if (string.IsNullOrEmpty(val)) return "";
            if (val.Contains(",") || val.Contains("\"") || val.Contains("\n"))
                return "\"" + val.Replace("\"", "\"\"") + "\"";
            return val;
        }

        private void ShowMessage(string type, string text)
        {
            string css = type == "success" ? "ep-alert ep-alert-success"
                       : type == "error"   ? "ep-alert ep-alert-error"
                                           : "ep-alert ep-alert-info";

            string icon = type == "success" ? "fas fa-check-circle"
                        : type == "error"   ? "fas fa-exclamation-circle"
                                            : "fas fa-info-circle";

            lblMessage.Text    = string.Format("<div class=\"{0}\"><i class=\"{1}\"></i> {2}</div>",
                css, icon, HttpUtility.HtmlEncode(text));
            lblMessage.Visible = true;
        }
    }
