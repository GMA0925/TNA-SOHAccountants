        // ?? Financials ????????????????????????????????????????????????????????
        private void LoadFinancials()
        {
            if (string.IsNullOrWhiteSpace(SessionNameSurname)) return;

            try
            {
                using (SqlConnection conn = new SqlConnection(ConnStr))
                {
                    conn.Open();

                    DateTime monthStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
                    DateTime monthEnd   = DateTime.Today;

                    // Current month summary
                    decimal totalHoursMonth = CalculateHoursForPeriod(conn, SessionNameSurname, SessionSiteId, monthStart, monthEnd);

                    // Days worked
                    string sqlDays = @"
                        SELECT COUNT(DISTINCT CAST(Timestamp AS DATE))
                        FROM   ReaderEvents
                        WHERE  UPPER(PersonName) = UPPER(@Name)
                          AND  SiteId   = @SiteId
                          AND  CAST(Timestamp AS DATE) >= @From
                          AND  CAST(Timestamp AS DATE) <= @To";

                    int daysWorked = 0;
                    using (SqlCommand cmd = new SqlCommand(sqlDays, conn))
                    {
                        cmd.Parameters.AddWithValue("@Name",   SessionNameSurname);
                        cmd.Parameters.AddWithValue("@SiteId", SessionSiteId);
                        cmd.Parameters.AddWithValue("@From",   monthStart);
                        cmd.Parameters.AddWithValue("@To",     monthEnd);
                        daysWorked = Convert.ToInt32(cmd.ExecuteScalar() ?? 0);
                    }

                    // Overtime = hours beyond standard per day
                    decimal expectedHours = daysWorked * StandardDayHours;
                    decimal overtime = totalHoursMonth > expectedHours ? totalHoursMonth - expectedHours : 0;
                    decimal avgDaily = daysWorked > 0 ? totalHoursMonth / daysWorked : 0;

                    lblFinTotalHours.Text    = totalHoursMonth.ToString("0.0");
                    lblFinDaysWorked.Text    = daysWorked.ToString();
                    lblFinOvertimeHours.Text = overtime.ToString("0.0");
                    lblFinAvgDaily.Text      = avgDaily.ToString("0.0");

                    lblFinMonth.Text = DateTime.Today.ToString("MMMM yyyy");

                    // Monthly hours breakdown (last 6 months)
                    LoadMonthlyBreakdown(conn);

                    // Daily hours this month
                    LoadDailyHours(conn, monthStart, monthEnd);
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine("LoadFinancials: " + ex.Message);
            }
        }

        private void LoadMonthlyBreakdown(SqlConnection conn)
        {
            StringBuilder sb = new StringBuilder();
            decimal maxHours = 1;

            var monthData = new System.Collections.Generic.List<Tuple<string, decimal>>();

            for (int i = 5; i >= 0; i--)
            {
                DateTime m = DateTime.Today.AddMonths(-i);
                DateTime mStart = new DateTime(m.Year, m.Month, 1);
                DateTime mEnd   = mStart.AddMonths(1).AddDays(-1);
                if (mEnd > DateTime.Today) mEnd = DateTime.Today;

                decimal hours = CalculateHoursForPeriod(conn, SessionNameSurname, SessionSiteId, mStart, mEnd);
                string label = mStart.ToString("MMM yyyy");
                monthData.Add(Tuple.Create(label, hours));
                if (hours > maxHours) maxHours = hours;
            }

            bool hasData = false;
            string[] barClasses = { "blue", "green", "purple", "blue", "green", "purple" };
            int idx = 0;

            foreach (var item in monthData)
            {
                if (item.Item2 > 0) hasData = true;
                int pct = maxHours > 0 ? (int)(item.Item2 / maxHours * 100) : 0;
                if (pct < 2 && item.Item2 > 0) pct = 2;

                sb.AppendFormat(
                    "<div class=\"ep-month-bar\">" +
                    "  <div class=\"ep-month-name\">{0}</div>" +
                    "  <div class=\"ep-month-progress\">" +
                    "    <div class=\"ep-month-fill {1}\" style=\"width:{2}%\">{3}</div>" +
                    "  </div>" +
                    "  <div class=\"ep-month-hours\">{4}h</div>" +
                    "</div>",
                    HttpUtility.HtmlEncode(item.Item1),
                    barClasses[idx % barClasses.Length],
                    pct,
                    item.Item2 > 0 ? item.Item2.ToString("0.0") : "",
                    item.Item2.ToString("0.0"));

                idx++;
            }

            litMonthlyBars.Text = sb.ToString();
            pnlNoFinancialData.Visible = !hasData;
            pnlMonthlyBreakdown.Visible = hasData;
        }

        private void LoadDailyHours(SqlConnection conn, DateTime monthStart, DateTime monthEnd)
        {
            DataTable dtDaily = new DataTable();
            dtDaily.Columns.Add("WorkDate", typeof(DateTime));
            dtDaily.Columns.Add("DayName", typeof(string));
            dtDaily.Columns.Add("FirstIn", typeof(string));
            dtDaily.Columns.Add("LastOut", typeof(string));
            dtDaily.Columns.Add("TotalHours", typeof(decimal));
            dtDaily.Columns.Add("OvertimeHours", typeof(decimal));

            string sql = @"
                SELECT
                    CAST(Timestamp AS DATE) AS EventDate,
                    Timestamp,
                    Direction
                FROM   ReaderEvents
                WHERE  UPPER(PersonName) = UPPER(@Name)
                  AND  SiteId   = @SiteId
                  AND  CAST(Timestamp AS DATE) >= @From
                  AND  CAST(Timestamp AS DATE) <= @To
                ORDER  BY Timestamp ASC";

            DataTable dtRaw = new DataTable();
            using (SqlCommand cmd = new SqlCommand(sql, conn))
            {
                cmd.Parameters.AddWithValue("@Name",   SessionNameSurname);
                cmd.Parameters.AddWithValue("@SiteId", SessionSiteId);
                cmd.Parameters.AddWithValue("@From",   monthStart);
                cmd.Parameters.AddWithValue("@To",     monthEnd);

                SqlDataAdapter da = new SqlDataAdapter(cmd);
                da.Fill(dtRaw);
            }

            // Group by date
            var dayGroups = new System.Collections.Generic.Dictionary<DateTime, System.Collections.Generic.List<DataRow>>();
            foreach (DataRow row in dtRaw.Rows)
            {
                DateTime dt = Convert.ToDateTime(row["EventDate"]);
                if (!dayGroups.ContainsKey(dt))
                    dayGroups[dt] = new System.Collections.Generic.List<DataRow>();
                dayGroups[dt].Add(row);
            }

            foreach (var kvp in dayGroups)
            {
                DateTime date = kvp.Key;
                var events = kvp.Value;

                string firstIn = "-";
                string lastOut = "-";
                decimal totalHrs = 0;

                DateTime? currentIn = null;

                foreach (DataRow ev in events)
                {
                    DateTime ts = Convert.ToDateTime(ev["Timestamp"]);
                    int dir = ev["Direction"] != DBNull.Value ? Convert.ToInt32(ev["Direction"]) : -1;

                    if (dir == 0) // IN
                    {
                        if (firstIn == "-") firstIn = ts.ToString("HH:mm");
                        currentIn = ts;
                    }
                    else if (dir == 1) // OUT
                    {
                        lastOut = ts.ToString("HH:mm");
                        if (currentIn.HasValue)
                        {
                            totalHrs += (decimal)(ts - currentIn.Value).TotalHours;
                            currentIn = null;
                        }
                    }
                }

                decimal ot = totalHrs > StandardDayHours ? totalHrs - StandardDayHours : 0;

                DataRow newRow = dtDaily.NewRow();
                newRow["WorkDate"]      = date;
                newRow["DayName"]       = date.ToString("ddd");
                newRow["FirstIn"]       = firstIn;
                newRow["LastOut"]       = lastOut;
                newRow["TotalHours"]    = Math.Round(totalHrs, 1);
                newRow["OvertimeHours"] = Math.Round(ot, 1);
                dtDaily.Rows.Add(newRow);
            }

            // Sort descending
            dtDaily.DefaultView.Sort = "WorkDate DESC";
            DataTable dtSorted = dtDaily.DefaultView.ToTable();

            if (dtSorted.Rows.Count > 0)
            {
                gvDailyHours.DataSource = dtSorted;
                gvDailyHours.DataBind();
                pnlDailyHours.Visible = true;
            }
        }

        /// <summary>
        /// Calculates actual worked hours by pairing IN/OUT events.
        /// </summary>
        private decimal CalculateHoursForPeriod(SqlConnection conn, string personName, string siteId,
            DateTime fromDate, DateTime toDate)
        {
            string sql = @"
                SELECT Timestamp, Direction
                FROM   ReaderEvents
                WHERE  UPPER(PersonName) = UPPER(@Name)
                  AND  SiteId   = @SiteId
                  AND  CAST(Timestamp AS DATE) >= @From
                  AND  CAST(Timestamp AS DATE) <= @To
                ORDER  BY Timestamp ASC";

            decimal totalHours = 0;
            bool needsOpen = conn.State != ConnectionState.Open;

            using (SqlCommand cmd = new SqlCommand(sql, conn))
            {
                cmd.Parameters.AddWithValue("@Name",   personName);
                cmd.Parameters.AddWithValue("@SiteId", siteId);
                cmd.Parameters.AddWithValue("@From",   fromDate.Date);
                cmd.Parameters.AddWithValue("@To",     toDate.Date);

                if (needsOpen) conn.Open();

                DateTime? lastIn = null;

                using (SqlDataReader r = cmd.ExecuteReader())
                {
                    while (r.Read())
                    {
                        DateTime ts = Convert.ToDateTime(r["Timestamp"]);
                        int dir = r["Direction"] != DBNull.Value ? Convert.ToInt32(r["Direction"]) : -1;

                        if (dir == 0) // IN
                        {
                            lastIn = ts;
                        }
                        else if (dir == 1 && lastIn.HasValue) // OUT
                        {
                            totalHours += (decimal)(ts - lastIn.Value).TotalHours;
                            lastIn = null;
                        }
                    }
                }
            }

            return Math.Round(totalHours, 1);
        }

