        // ?? Attendance stats ??????????????????????????????????????????????????
        private void LoadAttendanceStats()
        {
            if (string.IsNullOrWhiteSpace(SessionNameSurname)) return;

            try
            {
                using (SqlConnection conn = new SqlConnection(ConnStr))
                {
                    conn.Open();

                    // Days present this month
                    string sqlDays = @"
                        SELECT COUNT(DISTINCT CAST(Timestamp AS DATE))
                        FROM   ReaderEvents
                        WHERE  UPPER(PersonName) = UPPER(@Name)
                          AND  SiteId   = @SiteId
                          AND  YEAR(Timestamp)  = YEAR(GETDATE())
                          AND  MONTH(Timestamp) = MONTH(GETDATE())";

                    using (SqlCommand cmd = new SqlCommand(sqlDays, conn))
                    {
                        cmd.Parameters.AddWithValue("@Name",   SessionNameSurname);
                        cmd.Parameters.AddWithValue("@SiteId", SessionSiteId);
                        lblStatDaysThisMonth.Text = cmd.ExecuteScalar()?.ToString() ?? "0";
                    }

                    // Total events all time
                    string sqlTotal = @"
                        SELECT COUNT(*)
                        FROM   ReaderEvents
                        WHERE  UPPER(PersonName) = UPPER(@Name)
                          AND  SiteId = @SiteId";

                    using (SqlCommand cmd = new SqlCommand(sqlTotal, conn))
                    {
                        cmd.Parameters.AddWithValue("@Name",   SessionNameSurname);
                        cmd.Parameters.AddWithValue("@SiteId", SessionSiteId);
                        lblStatTotal.Text = cmd.ExecuteScalar()?.ToString() ?? "0";
                    }

                    // Calculate actual hours from paired IN/OUT events this month
                    decimal monthHours = CalculateHoursForPeriod(conn, SessionNameSurname, SessionSiteId,
                        new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1), DateTime.Today);
                    lblStatHours.Text = monthHours.ToString("0.0");

                    // Average hours per day
                    int daysPresent = 0;
                    int.TryParse(lblStatDaysThisMonth.Text, out daysPresent);
                    decimal avgHours = daysPresent > 0 ? monthHours / daysPresent : 0;
                    lblStatAvgHours.Text = avgHours.ToString("0.0");

                    // Late arrivals placeholder
                    lblStatLate.Text = "\u2014";
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine("LoadAttendanceStats: " + ex.Message);
            }
        }

