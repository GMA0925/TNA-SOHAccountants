        // ?? Change password ???????????????????????????????????????????????????
        protected void btnChangePassword_Click(object sender, EventArgs e)
        {
            string current = txtCurrentPassword.Text;
            string newPwd  = txtNewPassword.Text;
            string confirm = txtConfirmPassword.Text;

            if (string.IsNullOrWhiteSpace(current) || string.IsNullOrWhiteSpace(newPwd))
            {
                ShowMessage("error", "Please fill in all password fields.");
                return;
            }

            if (newPwd != confirm)
            {
                ShowMessage("error", "New password and confirmation do not match.");
                return;
            }

            if (newPwd.Length < 6)
            {
                ShowMessage("error", "New password must be at least 6 characters.");
                return;
            }

            try
            {
                using (SqlConnection conn = new SqlConnection(ConnStr))
                {
                    string sqlVerify = @"
                        SELECT COUNT(1) FROM Users
                        WHERE  Username = @Username AND PasswordHash = @OldPwd";

                    using (SqlCommand cmd = new SqlCommand(sqlVerify, conn))
                    {
                        cmd.Parameters.AddWithValue("@Username", SessionUsername);
                        cmd.Parameters.AddWithValue("@OldPwd",   current);
                        conn.Open();
                        int count = (int)cmd.ExecuteScalar();
                        if (count == 0)
                        {
                            ShowMessage("error", "Current password is incorrect.");
                            return;
                        }
                    }

                    string sqlUpdate = @"
                        UPDATE Users
                        SET    PasswordHash = @NewPwd
                        WHERE  Username = @Username";

                    using (SqlCommand cmd = new SqlCommand(sqlUpdate, conn))
                    {
                        cmd.Parameters.AddWithValue("@NewPwd",   newPwd);
                        cmd.Parameters.AddWithValue("@Username", SessionUsername);
                        cmd.ExecuteNonQuery();
                    }
                }

                txtCurrentPassword.Text = "";
                txtNewPassword.Text     = "";
                txtConfirmPassword.Text = "";
                ShowMessage("success", "Password changed successfully.");
            }
            catch (Exception ex)
            {
                ShowMessage("error", "Could not change password: " + ex.Message);
            }
        }

