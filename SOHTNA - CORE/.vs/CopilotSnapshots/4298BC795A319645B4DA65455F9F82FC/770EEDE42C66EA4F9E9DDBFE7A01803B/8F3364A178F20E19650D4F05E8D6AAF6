/* =============================================================
/* SOHTNA — System-wide Modal & Toast Notification Styles
   Used by: Navigation.ascx (injected on every page)
   ============================================================= */

/* ?? Overlay ??????????????????????????????????????????????? */
.sohtna-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.45);
    z-index: 10000;
    justify-content: center;
    align-items: center;
    padding: 20px;
    box-sizing: border-box;
}

.sohtna-modal-overlay.active {
    display: flex !important;
}

/* ?? Modal window ?????????????????????????????????????????? */
.sohtna-modal {
    background: #ffffff;
    border-radius: 8px;
    width: 100%;
    max-width: 760px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.28);
    display: flex;
    flex-direction: column;
    animation: sohtnaModalIn 0.18s ease;
}

@keyframes sohtnaModalIn {
    from { opacity: 0; transform: translateY(-18px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0)     scale(1);    }
}

/* ?? Modal header ?????????????????????????????????????????? */
.sohtna-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px 14px;
    border-bottom: 2px solid #0078D4;
    flex-shrink: 0;
}

.sohtna-modal-title {
    font-size: 20px;
    font-weight: 700;
    color: #0078D4;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
}

.sohtna-modal-close {
    background: none;
    border: none;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    color: #888;
    padding: 4px 8px;
    border-radius: 4px;
    transition: background 0.15s, color 0.15s;
}

.sohtna-modal-close:hover {
    background: #f0f0f0;
    color: #333;
}

/* ?? Modal body ???????????????????????????????????????????? */
.sohtna-modal-body {
    padding: 20px 24px;
    flex: 1;
}

/* 2-column form grid inside a modal */
.sohtna-modal-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 4px;
}

.sohtna-modal-grid .sohtna-field {
    display: flex;
    flex-direction: column;
}

.sohtna-modal-grid .sohtna-field.full-width {
    grid-column: 1 / -1;
}

.sohtna-field label {
    font-size: 13px;
    font-weight: 600;
    color: #444;
    margin-bottom: 5px;
}

.sohtna-field .form-control,
.sohtna-field input,
.sohtna-field select,
.sohtna-field textarea {
    width: 100%;
    padding: 8px 10px;
    font-size: 14px;
    border: 1px solid #ccc;
    border-radius: 4px;
    box-sizing: border-box;
    background: #fff;
    transition: border-color 0.15s, box-shadow 0.15s;
}

.sohtna-field .form-control:focus,
.sohtna-field input:focus,
.sohtna-field select:focus,
.sohtna-field textarea:focus {
    outline: none;
    border-color: #0078D4;
    box-shadow: 0 0 0 3px rgba(0, 120, 212, 0.12);
}

.sohtna-field .form-control[readonly],
.sohtna-field input[readonly] {
    background: #f5f5f5;
    color: #666;
}

/* ?? Modal footer ?????????????????????????????????????????? */
.sohtna-modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 14px 24px 20px;
    border-top: 1px solid #eee;
    flex-shrink: 0;
}

/* ?? Buttons ??????????????????????????????????????????????? */
.sohtna-btn {
    padding: 9px 20px;
    font-size: 14px;
    font-weight: 600;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: background 0.15s, transform 0.1s;
}

.sohtna-btn:active { transform: scale(0.97); }

.sohtna-btn-primary   { background: #0078D4; color: #fff; }
.sohtna-btn-primary:hover   { background: #005a9e; }

.sohtna-btn-success   { background: #28a745; color: #fff; }
.sohtna-btn-success:hover   { background: #218838; }

.sohtna-btn-danger    { background: #dc3545; color: #fff; }
.sohtna-btn-danger:hover    { background: #c82333; }

.sohtna-btn-secondary { background: #6c757d; color: #fff; }
.sohtna-btn-secondary:hover { background: #5a6268; }

/* ?? Toast notifications ??????????????????????????????????? */
#sohtna-toast-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 11000;
    display: flex;
    flex-direction: column;
    gap: 10px;
    pointer-events: none;
}

.sohtna-toast {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.18);
    padding: 14px 18px;
    min-width: 280px;
    max-width: 380px;
    pointer-events: all;
    border-left: 4px solid #0078D4;
    animation: sohtnaToastIn 0.22s ease;
    position: relative;
}

.sohtna-toast.toast-success { border-left-color: #28a745; }
.sohtna-toast.toast-error   { border-left-color: #dc3545; }
.sohtna-toast.toast-warning { border-left-color: #ffc107; }
.sohtna-toast.toast-info    { border-left-color: #0078D4; }

.sohtna-toast.toast-hiding {
    animation: sohtnaToastOut 0.22s ease forwards;
}

@keyframes sohtnaToastIn {
    from { opacity: 0; transform: translateX(30px); }
    to   { opacity: 1; transform: translateX(0);    }
}

@keyframes sohtnaToastOut {
    from { opacity: 1; transform: translateX(0);    }
    to   { opacity: 0; transform: translateX(30px); }
}

.sohtna-toast-icon {
    font-size: 18px;
    flex-shrink: 0;
    margin-top: 1px;
}

.toast-success .sohtna-toast-icon { color: #28a745; }
.toast-error   .sohtna-toast-icon { color: #dc3545; }
.toast-warning .sohtna-toast-icon { color: #ffc107; }
.toast-info    .sohtna-toast-icon { color: #0078D4; }

.sohtna-toast-body {
    flex: 1;
}

.sohtna-toast-title {
    font-size: 13px;
    font-weight: 700;
    color: #222;
    margin-bottom: 2px;
}

.sohtna-toast-message {
    font-size: 13px;
    color: #555;
    line-height: 1.4;
}

.sohtna-toast-close {
    background: none;
    border: none;
    font-size: 16px;
    color: #aaa;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    flex-shrink: 0;
    align-self: flex-start;
}

.sohtna-toast-close:hover { color: #555; }

/* ?? Progress bar inside toast ????????????????????????????? */
.sohtna-toast-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 3px;
    width: 100%;
    border-radius: 0 0 8px 8px;
    background: rgba(0,0,0,0.08);
    overflow: hidden;
}

.sohtna-toast-progress-bar {
    height: 100%;
    width: 100%;
    transform-origin: left;
    transition: transform linear;
}

.toast-success .sohtna-toast-progress-bar { background: #28a745; }
.toast-error   .sohtna-toast-progress-bar { background: #dc3545; }
.toast-warning .sohtna-toast-progress-bar { background: #ffc107; }
.toast-info    .sohtna-toast-progress-bar { background: #0078D4; }

/* ?? Confirm dialog ???????????????????????????????????????? */
.sohtna-confirm-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.45);
    z-index: 10500;
    justify-content: center;
    align-items: center;
    padding: 20px;
    box-sizing: border-box;
}

.sohtna-confirm-overlay.active {
    display: flex !important;
}

.sohtna-confirm {
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.22);
    max-width: 440px;
    width: 90%;
    text-align: center;
    overflow: hidden;
    animation: sohtnaModalIn 0.18s ease;
}

.sohtna-confirm-header {
    padding: 18px 20px;
    color: #fff;
    background: linear-gradient(135deg, #0078D4, #00b4d8);
}

.sohtna-confirm-header.confirm-success { background: linear-gradient(135deg, #28a745, #5cb85c); }
.sohtna-confirm-header.confirm-error   { background: linear-gradient(135deg, #dc3545, #e0686f); }
.sohtna-confirm-header.confirm-warning { background: linear-gradient(135deg, #fd7e14, #ffc107); }
.sohtna-confirm-header.confirm-info    { background: linear-gradient(135deg, #0078D4, #00b4d8); }

.sohtna-confirm-header i {
    font-size: 28px;
    margin-bottom: 6px;
    display: block;
}

.sohtna-confirm-header h4 {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
}

.sohtna-confirm-body {
    padding: 22px 24px 14px;
    font-size: 14px;
    color: #444;
    line-height: 1.6;
}

.sohtna-confirm-footer {
    padding: 10px 24px 20px;
    display: flex;
    justify-content: center;
    gap: 10px;
}

.sohtna-confirm-footer .sohtna-btn {
    min-width: 110px;
}

/* ?? Responsive ???????????????????????????????????????????? */
@media (max-width: 600px) {
    .sohtna-modal { max-width: 100%; border-radius: 0; max-height: 100vh; }
    .sohtna-modal-grid { grid-template-columns: 1fr; }
    #sohtna-toast-container { left: 12px; right: 12px; bottom: 12px; }
    .sohtna-toast { min-width: unset; max-width: 100%; }
}
