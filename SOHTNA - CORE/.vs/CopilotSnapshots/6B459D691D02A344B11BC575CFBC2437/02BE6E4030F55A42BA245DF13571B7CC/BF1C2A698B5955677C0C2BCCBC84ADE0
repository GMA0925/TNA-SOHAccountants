        /// <summary>
        /// Safe redirect that avoids ThreadAbortException.
        /// </summary>
        private void SafeRedirect(string url)
        {
            try
            {
                Response.Redirect(url, false);
                Context.ApplicationInstance.CompleteRequest();
            }
            catch (Exception ex)
            {
                ErrorReporter.ReportError(ex, $"Navigation.ascx - SafeRedirect({url})");
                System.Diagnostics.Debug.WriteLine($"Error during redirect to {url}: {ex.Message}");
            }
        }

