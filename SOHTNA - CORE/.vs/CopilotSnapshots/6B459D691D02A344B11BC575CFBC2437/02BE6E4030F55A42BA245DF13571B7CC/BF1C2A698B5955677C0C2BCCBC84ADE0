        protected void Page_Load(object sender, EventArgs e)
        {
            try
            {
                if (!IsPostBack)
                {
                    ConfigureNavigationByRole();
                    DisplayUserInfo();
                    HighlightCurrentPage();
                }
            }
            catch (Exception ex)
            {
                ErrorReporter.ReportError(ex, "Navigation.ascx - Page_Load");
                System.Diagnostics.Debug.WriteLine($"Navigation Page_Load error: {ex.Message}");
            }
        }

        private void DisplayUserInfo()
        {
            try
            {
                string userRole = Session["Role"]?.ToString() ?? "User";
                lblUserRole.Text = userRole;

                string siteId = Session["SiteId"]?.ToString() ?? "Not Assigned";
                lblUserSiteId.Text = siteId;
            }
            catch (Exception ex)
            {
                ErrorReporter.ReportError(ex, "Navigation.ascx - DisplayUserInfo");
                System.Diagnostics.Debug.WriteLine($"Error displaying user info: {ex.Message}");
                if (lblUserRole != null) lblUserRole.Text = "User";
                if (lblUserSiteId != null) lblUserSiteId.Text = "Error";
            }
        }

        private void ConfigureNavigationByRole()
        {
            try
            {
                string userRole = Session["Role"]?.ToString() ?? "User";
                string username = Session["Username"]?.ToString() ?? "";

                // Try to load permissions from the RolePermissions table
                DataTable permissions = LoadRolePermissions(userRole);

                if (permissions != null && permissions.Rows.Count > 0)
                {
                    // Database-driven permissions
                    ApplyPermissionsFromDB(permissions);
                }
                else
                {
                    // Fallback to hardcoded defaults
                    ApplyHardcodedPermissions(userRole);
                }

                // Apply user-level overrides (takes priority over role permissions)
                if (!string.IsNullOrEmpty(username))
                {
                    DataTable userOverrides = LoadUserNavPermissions(username);
                    if (userOverrides != null && userOverrides.Rows.Count > 0)
                    {
                        ApplyUserNavOverrides(userOverrides);
                    }
                }
            }
            catch (Exception ex)
            {
                ErrorReporter.ReportError(ex, "Navigation.ascx - ConfigureNavigationByRole");
                System.Diagnostics.Debug.WriteLine($"Error configuring navigation: {ex.Message}");
            }
        }

        /// <summary>
        /// Load permissions from the RolePermissions table for the given role
        /// </summary>
        private DataTable LoadRolePermissions(string roleName)
        {
            try
            {
                string connStr = Properties.Settings.Default.SQLCon;
                using (SqlConnection conn = new SqlConnection(connStr))
                {
                    string query = "SELECT FeatureKey, IsAllowed FROM RolePermissions WHERE RoleName = @RoleName";
                    SqlCommand cmd = new SqlCommand(query, conn);
                    cmd.Parameters.AddWithValue("@RoleName", roleName);
                    cmd.CommandTimeout = 10;

                    SqlDataAdapter da = new SqlDataAdapter(cmd);
                    DataTable dt = new DataTable();
                    da.Fill(dt);
                    return dt;
                }
            }
            catch (Exception)
            {
                // Table may not exist yet - return null to use fallback
                return null;
            }
        }

        /// <summary>
        /// Apply button visibility from the database permissions table
        /// </summary>
        private void ApplyPermissionsFromDB(DataTable permissions)
        {
            // Build a lookup dictionary: FeatureKey -> IsAllowed
            var permDict = new System.Collections.Generic.Dictionary<string, bool>(StringComparer.OrdinalIgnoreCase);
            foreach (DataRow row in permissions.Rows)
            {
                string key = row["FeatureKey"].ToString();
                bool allowed = Convert.ToBoolean(row["IsAllowed"]);
                permDict[key] = allowed;
            }

            // Map FeatureKeys to navigation buttons
            SetButtonVisibility(btnDashboard, permDict, "Dashboard");
            SetButtonVisibility(btnUsers, permDict, "UserManagement");
            SetButtonVisibility(btnConfig, permDict, "ConfigTools");
            SetButtonVisibility(btnSyncLog, permDict, "SyncLog");
            SetButtonVisibility(btnEmployees, permDict, "Employees");
            SetButtonVisibility(btnShiftManagement, permDict, "ShiftManagement");
            SetButtonVisibility(btnReports, permDict, "Reports");
            SetButtonVisibility(btnPayroll, permDict, "Payroll");
            SetButtonVisibility(btnAttendance, permDict, "Attendance");
            SetButtonVisibility(btnLeave, permDict, "Leave");
            SetButtonVisibility(btnTimesheet, permDict, "Timesheet");
            SetButtonVisibility(btnCompliance, permDict, "Compliance");
            SetButtonVisibility(btnSettings, permDict, "Settings");
            SetButtonVisibility(btnNotifications, permDict, "Notifications");
            SetButtonVisibility(btnProfile, permDict, "Profile");
        }

        /// <summary>
        /// Set a single button's visibility from the permission dictionary
        /// </summary>
        private void SetButtonVisibility(LinkButton btn, System.Collections.Generic.Dictionary<string, bool> permDict, string featureKey)
        {
            if (btn == null) return;

            if (permDict.ContainsKey(featureKey))
                btn.Visible = permDict[featureKey];
            else
                btn.Visible = true; // Default to visible if not in table
        }

        /// <summary>
        /// Fallback hardcoded permission logic (used when RolePermissions table doesn't exist)
        /// </summary>
        private void ApplyHardcodedPermissions(string userRole)
        {
            bool isAdmin = userRole == "Admin";
            bool isManager = userRole == "Manager";

            btnUsers.Visible = isAdmin;
            btnConfig.Visible = isAdmin;
            btnSyncLog.Visible = isAdmin;
            btnSettings.Visible = isAdmin;
            btnEmployees.Visible = isAdmin || isManager;

            btnDashboard.Visible = true;
            btnShiftManagement.Visible = isAdmin || isManager;
            btnReports.Visible = isAdmin || isManager;
            btnPayroll.Visible = true;
            btnAttendance.Visible = true;
            btnLeave.Visible = true;
            btnTimesheet.Visible = true;
            btnCompliance.Visible = isAdmin || isManager;
            btnNotifications.Visible = true;
            btnProfile.Visible = true;
        }

        /// <summary>
        /// Load user-level nav permission overrides from the UserNavPermissions table
        /// </summary>
        private DataTable LoadUserNavPermissions(string username)
        {
            try
            {
                string connStr = Properties.Settings.Default.SQLCon;
                using (SqlConnection conn = new SqlConnection(connStr))
                {
                    string query = "SELECT FeatureKey, IsAllowed FROM UserNavPermissions WHERE Username = @Username";
                    SqlCommand cmd = new SqlCommand(query, conn);
                    cmd.Parameters.AddWithValue("@Username", username);
                    cmd.CommandTimeout = 10;

                    SqlDataAdapter da = new SqlDataAdapter(cmd);
                    DataTable dt = new DataTable();
                    da.Fill(dt);
                    return dt;
                }
            }
            catch (Exception)
            {
                // Table may not exist yet - return null to skip overrides
                return null;
            }
        }

        /// <summary>
        /// Apply user-level nav permission overrides (takes priority over role permissions)
        /// </summary>
        private void ApplyUserNavOverrides(DataTable userOverrides)
        {
            var overrideDict = new System.Collections.Generic.Dictionary<string, bool>(StringComparer.OrdinalIgnoreCase);
            foreach (DataRow row in userOverrides.Rows)
            {
                string key = row["FeatureKey"].ToString();
                bool allowed = Convert.ToBoolean(row["IsAllowed"]);
                overrideDict[key] = allowed;
            }

            SetButtonVisibility(btnDashboard, overrideDict, "Dashboard");
            SetButtonVisibility(btnUsers, overrideDict, "UserManagement");
            SetButtonVisibility(btnConfig, overrideDict, "ConfigTools");
            SetButtonVisibility(btnSyncLog, overrideDict, "SyncLog");
            SetButtonVisibility(btnEmployees, overrideDict, "Employees");
            SetButtonVisibility(btnShiftManagement, overrideDict, "ShiftManagement");
            SetButtonVisibility(btnReports, overrideDict, "Reports");
            SetButtonVisibility(btnPayroll, overrideDict, "Payroll");
            SetButtonVisibility(btnAttendance, overrideDict, "Attendance");
            SetButtonVisibility(btnLeave, overrideDict, "Leave");
            SetButtonVisibility(btnTimesheet, overrideDict, "Timesheet");
            SetButtonVisibility(btnCompliance, overrideDict, "Compliance");
            SetButtonVisibility(btnSettings, overrideDict, "Settings");
            SetButtonVisibility(btnNotifications, overrideDict, "Notifications");
            SetButtonVisibility(btnProfile, overrideDict, "Profile");
        }

