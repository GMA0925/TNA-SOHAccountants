        #region Helper Methods

        // Upsert a key/value general setting scoped to the current SiteId.
        private void SaveSetting(SqlConnection conn, string key, string value)
        {
            string query;
            if (ColumnExists(conn, "SystemSettings", "SiteId"))
            {
                query = @"
                    IF EXISTS (SELECT 1 FROM SystemSettings WHERE SettingKey = @SettingKey AND SiteId = @SiteId)
                        UPDATE SystemSettings
                        SET SettingValue = @SettingValue, ModifiedDate = GETDATE()
                        WHERE SettingKey = @SettingKey AND SiteId = @SiteId
                    ELSE
                        INSERT INTO SystemSettings (SiteId, SettingKey, SettingValue, SettingType, Category, IsActive)
                        VALUES (@SiteId, @SettingKey, @SettingValue, 'String', 'General', 1)";
            }
            else
            {
                query = @"
                    IF EXISTS (SELECT 1 FROM SystemSettings WHERE SettingKey = @SettingKey)
                        UPDATE SystemSettings
                        SET SettingValue = @SettingValue, ModifiedDate = GETDATE()
                        WHERE SettingKey = @SettingKey
                    ELSE
                        INSERT INTO SystemSettings (SettingKey, SettingValue, SettingType, Category, IsActive)
                        VALUES (@SettingKey, @SettingValue, 'String', 'General', 1)";
            }

            SqlCommand cmd = new SqlCommand(query, conn);
            cmd.Parameters.AddWithValue("@SiteId",       _siteId);
            cmd.Parameters.AddWithValue("@SettingKey",   key);
            cmd.Parameters.AddWithValue("@SettingValue", value);
            cmd.ExecuteNonQuery();
        }

        // Safely set a DropDownList value — ignores invalid values instead of throwing.
        private static void TrySetDropDown(System.Web.UI.WebControls.DropDownList ddl, string value)
        {
            var item = ddl.Items.FindByValue(value);
            if (item != null) ddl.SelectedValue = value;
        }

        private void ShowMessage(string message, string type)
        {
            lblMessage.Text     = message;
            lblMessage.Visible  = true;
            lblMessage.CssClass = type == "success" ? "success-message" : "error-message";

            if (type == "success")
                SohTnaNotify.Success(this, "Success", message);
            else
                SohTnaNotify.Error(this, "Error", message);
        }

