        private void LoadGeneralSettings()
        {
            try
            {
                using (SqlConnection conn = new SqlConnection(_connStr))
                {
                    string query;
                    if (ColumnExists(conn, "SystemSettings", "SiteId"))
                    {
                        query = @"
                            SELECT SettingKey, SettingValue
                            FROM SystemSettings
                            WHERE Category = 'General' AND IsActive = 1
                              AND SiteId = CASE
                                    WHEN EXISTS (SELECT 1 FROM SystemSettings WHERE Category='General' AND IsActive=1 AND SiteId=@SiteId)
                                    THEN @SiteId ELSE 'DEFAULT' END";
                    }
                    else
                    {
                        query = @"
                            SELECT SettingKey, SettingValue
                            FROM SystemSettings
                            WHERE Category = 'General' AND IsActive = 1";
                    }

                    SqlCommand cmd = new SqlCommand(query, conn);
                    cmd.Parameters.AddWithValue("@SiteId", _siteId);
                    SqlDataAdapter da = new SqlDataAdapter(cmd);
                    DataTable dt = new DataTable();
                    da.Fill(dt);

                    foreach (DataRow row in dt.Rows)
                    {
                        string key = row["SettingKey"].ToString();
                        string value = row["SettingValue"].ToString();

                        switch (key)
                        {
                            case "CompanyName":   txtCompanyName.Text = value; break;
                            case "CompanyEmail":  txtCompanyEmail.Text = value; break;
                            case "CompanyPhone":  txtCompanyPhone.Text = value; break;
                            case "TimeZone":      TrySetDropDown(ddlTimeZone, value); break;
                            case "Currency":      TrySetDropDown(ddlCurrency, value); break;
                            case "DateFormat":    TrySetDropDown(ddlDateFormat, value); break;
                            case "MaintenanceMode": chkMaintenanceMode.Checked = value.ToLower() == "true"; break;
                        }
                    }

                    // If no saved DB value exists for timezone/currency/date format,
                    // fall back to the values detected from the client browser (Intl API).
                    if (ddlTimeZone.SelectedIndex == 0 && !string.IsNullOrEmpty(hfClientTimezone.Value))
                        TrySetDropDown(ddlTimeZone, hfClientTimezone.Value);

                    if (ddlCurrency.SelectedIndex == 0 && !string.IsNullOrEmpty(hfClientCurrency.Value))
                        TrySetDropDown(ddlCurrency, hfClientCurrency.Value);

                    if (ddlDateFormat.SelectedIndex == 0 && !string.IsNullOrEmpty(hfClientDateFormat.Value))
                        TrySetDropDown(ddlDateFormat, hfClientDateFormat.Value);
                }
            }
            catch (Exception ex)
            {
                ShowMessage("Error loading general settings: " + ex.Message, "error");
            }
        }

