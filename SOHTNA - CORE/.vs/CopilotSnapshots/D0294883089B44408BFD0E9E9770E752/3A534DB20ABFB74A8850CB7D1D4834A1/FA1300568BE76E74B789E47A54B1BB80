        // Returns true when the given column exists on the given table.
        // Used to guard SiteId queries before the migration script has been run.
        private bool ColumnExists(SqlConnection conn, string tableName, string columnName)
        {
            string sql = @"SELECT COUNT(1) FROM INFORMATION_SCHEMA.COLUMNS
                           WHERE TABLE_NAME = @t AND COLUMN_NAME = @c";
            using (SqlCommand cmd = new SqlCommand(sql, conn))
            {
                cmd.Parameters.AddWithValue("@t", tableName);
                cmd.Parameters.AddWithValue("@c", columnName);
                if (conn.State != System.Data.ConnectionState.Open) conn.Open();
                return (int)cmd.ExecuteScalar() > 0;
            }
        }

        // Returns true when the given table exists in the database.
        // Used to skip queries against tables that may not have been created yet.
        private bool TableExists(SqlConnection conn, string tableName)
        {
            string sql = @"SELECT COUNT(1) FROM INFORMATION_SCHEMA.TABLES
                           WHERE TABLE_NAME = @t";
            using (SqlCommand cmd = new SqlCommand(sql, conn))
            {
                cmd.Parameters.AddWithValue("@t", tableName);
                if (conn.State != System.Data.ConnectionState.Open) conn.Open();
                return (int)cmd.ExecuteScalar() > 0;
            }
        }

        protected void Page_Load(object sender, EventArgs e)
        {
            if (Session["Username"] == null || Session["Role"]?.ToString() != "Admin")
            {
                Response.Redirect("Login.aspx");
                return;
            }

            _siteId = Session["SiteId"]?.ToString() ?? "DEFAULT";

            if (!IsPostBack)
            {
                lblSiteContext.Text = _siteId;
                LoadGeneralSettings();
                LoadAttendanceSettings();
                LoadLeaveSettings();
                LoadEmailSettings();
                LoadSecuritySettings();
                LoadNotificationSettings();
                LoadFeatureToggles();
            }
            else
            {
                // Keep the site label visible on every postback
                lblSiteContext.Text = _siteId;
            }
        }

