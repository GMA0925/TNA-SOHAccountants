        private void LoadNotificationSettings()
        {
            try
            {
                // Load notification system settings
                using (SqlConnection conn = new SqlConnection(_connStr))
                {
                    if (!TableExists(conn, "NotificationSettings"))
                    {
                        // Table not yet created — skip silently
                    }
                    else
                    {
                        string query;
                        if (ColumnExists(conn, "NotificationSettings", "SiteId"))
                        {
                            query = @"
                                SELECT TOP 1 * FROM NotificationSettings
                                WHERE SiteId = CASE
                                        WHEN EXISTS (SELECT 1 FROM NotificationSettings WHERE SiteId=@SiteId)
                                        THEN @SiteId ELSE 'DEFAULT' END";
                        }
                        else
                        {
                            query = @"SELECT TOP 1 * FROM NotificationSettings";
                        }

                        SqlCommand cmd = new SqlCommand(query, conn);
                        cmd.Parameters.AddWithValue("@SiteId", _siteId);
                        using (SqlDataReader reader = cmd.ExecuteReader())
                        {
                            if (reader.Read())
                            {
                                chkEmailNotif.Checked         = (bool)reader["EnableEmailNotifications"];
                                chkSMSNotif.Checked           = (bool)reader["EnableSMSNotifications"];
                                chkInAppNotif.Checked         = (bool)reader["EnableInAppNotifications"];
                                chkPushNotif.Checked          = (bool)reader["EnablePushNotifications"];
                                txtNotifEmailRetries.Text     = reader["EmailRetryAttempts"].ToString();
                                txtNotifRetryInterval.Text    = reader["EmailRetryIntervalMinutes"].ToString();
                                txtNotifQueueInterval.Text    = reader["NotificationQueueProcessingIntervalSeconds"].ToString();
                                txtNotifRetention.Text        = reader["NotificationRetentionDays"].ToString();
                                chkNotifDeduplication.Checked = (bool)reader["EnableNotificationDeduplication"];
                            }
                        }
                    }
                }

                // Load reminders scoped to this site (fall back to DEFAULT)
                using (SqlConnection conn = new SqlConnection(_connStr))
                {
                    if (TableExists(conn, "ReminderSettings"))
                    {
                        string query;
                        if (ColumnExists(conn, "ReminderSettings", "SiteId"))
                        {
                            query = @"
                                SELECT * FROM ReminderSettings
                                WHERE SiteId = CASE
                                        WHEN EXISTS (SELECT 1 FROM ReminderSettings WHERE SiteId=@SiteId)
                                        THEN @SiteId ELSE 'DEFAULT' END
                                ORDER BY ReminderType";
                        }
                        else
                        {
                            query = @"SELECT * FROM ReminderSettings ORDER BY ReminderType";
                        }
                        SqlCommand cmd = new SqlCommand(query, conn);
                        cmd.Parameters.AddWithValue("@SiteId", _siteId);
                        SqlDataAdapter da = new SqlDataAdapter(cmd);
                        DataTable dt = new DataTable();
                        da.Fill(dt);
                        gvNotifReminders.DataSource = dt;
                        gvNotifReminders.DataBind();
                    }
                }

                // Load templates scoped to this site (fall back to DEFAULT)
                using (SqlConnection conn = new SqlConnection(_connStr))
                {
                    if (TableExists(conn, "NotificationTemplates"))
                    {
                        // Build SELECT list based on columns that actually exist
                        bool hasEventType   = ColumnExists(conn, "NotificationTemplates", "EventType");
                        bool hasTemplateType = ColumnExists(conn, "NotificationTemplates", "TemplateType");
                        bool hasSiteId      = ColumnExists(conn, "NotificationTemplates", "SiteId");

                        string selectCols = "TemplateID, TemplateName"
                            + (hasTemplateType ? ", TemplateType" : "")
                            + (hasEventType    ? ", EventType"    : "");

                        string query;
                        if (hasSiteId)
                        {
                            query = string.Format(@"
                                SELECT {0}
                                FROM NotificationTemplates
                                WHERE IsActive = 1
                                  AND SiteId = CASE
                                        WHEN EXISTS (SELECT 1 FROM NotificationTemplates WHERE IsActive=1 AND SiteId=@SiteId)
                                        THEN @SiteId ELSE 'DEFAULT' END
                                ORDER BY TemplateName", selectCols);
                        }
                        else
                        {
                            query = string.Format(@"
                                SELECT {0}
                                FROM NotificationTemplates
                                WHERE IsActive = 1
                                ORDER BY TemplateName", selectCols);
                        }
                        SqlCommand cmd = new SqlCommand(query, conn);
                        cmd.Parameters.AddWithValue("@SiteId", _siteId);
                        SqlDataAdapter da = new SqlDataAdapter(cmd);
                        DataTable dt = new DataTable();
                        da.Fill(dt);
                        gvNotifTemplates.DataSource = dt;
                        gvNotifTemplates.DataBind();
                    }
                }
            }
            catch (Exception ex)
            {
                ShowMessage("Error loading notification settings: " + ex.Message, "error");
            }
        }

