                    cmd.Parameters.AddWithValue("@EnableEmailNotifications",                  chkEmailNotif.Checked);
                    cmd.Parameters.AddWithValue("@EnableSMSNotifications",                    chkSMSNotif.Checked);
                    cmd.Parameters.AddWithValue("@EnableInAppNotifications",                  chkInAppNotif.Checked);
                    cmd.Parameters.AddWithValue("@EnablePushNotifications",                   chkPushNotif.Checked);
                    cmd.Parameters.AddWithValue("@EmailRetryAttempts",                        int.Parse(txtNotifEmailRetries.Text));
                    cmd.Parameters.AddWithValue("@EmailRetryIntervalMinutes",                 int.Parse(txtNotifRetryInterval.Text));
                    cmd.Parameters.AddWithValue("@NotificationQueueProcessingIntervalSeconds",int.Parse(txtNotifQueueInterval.Text));
                    cmd.Parameters.AddWithValue("@NotificationRetentionDays",                 int.Parse(txtNotifRetention.Text));
                    cmd.Parameters.AddWithValue("@EnableNotificationDeduplication",           chkNotifDeduplication.Checked);
                    conn.Open();
                    cmd.ExecuteNonQuery();
                }

                ShowMessage("Notification settings saved for site: " + _siteId, "success");
                LoadNotificationSettings();
            }
            catch (Exception ex)
            {
                ShowMessage("Error saving notification settings: " + ex.Message, "error");
            }
        }

