        protected void gvFeatures_RowCommand(object sender, GridViewCommandEventArgs e)
        {
            if (e.CommandName == "Toggle")
            {
                hfActiveTab.Value = "features";
                _siteId = Session["SiteId"]?.ToString() ?? "DEFAULT";
                try
                {
                    int featureId = Convert.ToInt32(e.CommandArgument);
                    using (SqlConnection conn = new SqlConnection(_connStr))
                    {
                        // Only toggle the row that belongs to this site
                        string query = @"
                            UPDATE FeatureToggles 
                            SET IsEnabled = ~IsEnabled, ModifiedDate = GETDATE()
                            WHERE FeatureID = @FeatureID AND SiteId = @SiteId";

                        SqlCommand cmd = new SqlCommand(query, conn);
                        cmd.Parameters.AddWithValue("@FeatureID", featureId);
                        cmd.Parameters.AddWithValue("@SiteId", _siteId);
                        conn.Open();
                        int rows = cmd.ExecuteNonQuery();

                        // If no site-specific row exists yet, copy the DEFAULT row and toggle it
                        if (rows == 0)
                        {
                            cmd.CommandText = @"
                                INSERT INTO FeatureToggles (SiteId, FeatureName, FeatureDescription, IsEnabled, ModifiedDate)
                                SELECT @SiteId, FeatureName, FeatureDescription, ~IsEnabled, GETDATE()
                                FROM FeatureToggles
                                WHERE FeatureID = @FeatureID";
                            cmd.ExecuteNonQuery();
                        }
                    }

                    LoadFeatureToggles();
                    ShowMessage("Feature toggle updated for site: " + _siteId, "success");
                }
                catch (Exception ex)
                {
                    ShowMessage("Error updating feature toggle: " + ex.Message, "error");
                }
            }
        }

