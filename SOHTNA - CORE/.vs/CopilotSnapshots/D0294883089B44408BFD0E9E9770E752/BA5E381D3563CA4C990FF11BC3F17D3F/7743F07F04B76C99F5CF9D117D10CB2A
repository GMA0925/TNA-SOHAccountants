        protected void Page_Load(object sender, EventArgs e)
        {
            if (Session["Username"] == null)
            {
                Response.Redirect("Login.aspx", false);
                Context.ApplicationInstance.CompleteRequest();
                return;
            }

            string role = Session["Role"]?.ToString()?.Trim();
            if (role == null || !role.Equals("Admin", StringComparison.OrdinalIgnoreCase))
            {
                Response.Redirect("Dashboard.aspx", false);
                Context.ApplicationInstance.CompleteRequest();
                return;
            }

            if (!IsPostBack)
            {
                LoadSites();
                LoadManualSites();
            }
        }

        private void LoadSites()
        {
            try
            {
                using (SqlConnection conn = new SqlConnection(GetConnectionString()))
                {
                    string query = "SELECT SiteID, SiteName, SiteCode FROM Sites WHERE IsActive = 1 ORDER BY SiteName";
                    using (SqlCommand cmd = new SqlCommand(query, conn))
                    {
                        cmd.CommandTimeout = 15;
                        using (SqlDataAdapter da = new SqlDataAdapter(cmd))
                        {
                            DataTable dt = new DataTable();
                            da.Fill(dt);

                            ddlSiteID.Items.Clear();
                            ddlSiteID.Items.Add(new System.Web.UI.WebControls.ListItem("-- Select Site --", ""));
                            foreach (DataRow row in dt.Rows)
                            {
                                string siteName = row["SiteName"] != DBNull.Value ? row["SiteName"].ToString() : "";
                                string siteCode = row["SiteCode"] != DBNull.Value ? row["SiteCode"].ToString() : "";
                                string displayText = string.IsNullOrEmpty(siteCode) ? siteName : $"{siteName} ({siteCode})";
                                // Use SiteCode as the value since ReaderEvents.SiteId stores the site code, not numeric ID
                                string value = !string.IsNullOrEmpty(siteCode) ? siteCode : row["SiteID"].ToString();
                                ddlSiteID.Items.Add(new System.Web.UI.WebControls.ListItem(displayText, value));
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                ShowMessage("Error loading sites: " + ex.Message, false);
            }
        }

