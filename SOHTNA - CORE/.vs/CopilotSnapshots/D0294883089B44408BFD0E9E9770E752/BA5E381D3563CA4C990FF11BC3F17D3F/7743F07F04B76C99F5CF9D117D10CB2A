        private void LoadEmployees()
        {
            string siteId = ddlSiteID.SelectedValue;
            ddlEmployee.Items.Clear();
            
            if (string.IsNullOrEmpty(siteId))
            {
                ddlEmployee.Items.Add(new ListItem("-- Select Site First --", ""));
                return;
            }

            try
            {
                using (SqlConnection conn = new SqlConnection(GetConnectionString()))
                {
                    conn.Open();
                    // First try to load with IsActive = 1
                    string query = "SELECT EmployeeID, NameSurname, EmployeeCode FROM Employees WHERE SiteID = @SiteID AND IsActive = 1 ORDER BY NameSurname";
                    using (SqlCommand cmd = new SqlCommand(query, conn))
                    {
                        cmd.Parameters.AddWithValue("@SiteID", siteId);
                        try
                        {
                            using (SqlDataReader reader = cmd.ExecuteReader())
                            {
                                ddlEmployee.Items.Add(new ListItem("-- Select Employee --", ""));
                                while (reader.Read())
                                {
                                    string name = reader["NameSurname"].ToString();
                                    string code = reader["EmployeeCode"] != DBNull.Value ? reader["EmployeeCode"].ToString() : "";
                                    string text = string.IsNullOrEmpty(code) ? name : $"{name} ({code})";
                                    ddlEmployee.Items.Add(new ListItem(text, name)); // storing Name as value since ReaderEvents uses PersonName
                                }
                            }
                        }
                        catch
                        {
                            // Fallback if IsActive column doesn't exist
                            ddlEmployee.Items.Clear();
                            query = "SELECT EmployeeID, NameSurname, EmployeeCode FROM Employees WHERE SiteID = @SiteID ORDER BY NameSurname";
                            cmd.CommandText = query;
                            using (SqlDataReader reader = cmd.ExecuteReader())
                            {
                                ddlEmployee.Items.Add(new ListItem("-- Select Employee --", ""));
                                while (reader.Read())
                                {
                                    string name = reader["NameSurname"].ToString();
                                    string code = reader["EmployeeCode"] != DBNull.Value ? reader["EmployeeCode"].ToString() : "";
                                    string text = string.IsNullOrEmpty(code) ? name : $"{name} ({code})";
                                    ddlEmployee.Items.Add(new ListItem(text, name));
                                }
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                ShowMessage("Error loading employees: " + ex.Message, false);
            }
        }

