        private void LoadIncompleteEntries()
        {
            string siteId = ddlSiteID.SelectedValue;
            string empName = ddlEmployee.SelectedValue;

            if (string.IsNullOrEmpty(siteId))
            {
                ShowMessage("Please select a site.", false);
                return;
            }

            if (string.IsNullOrEmpty(empName))
            {
                gvIncomplete.DataSource = null;
                gvIncomplete.DataBind();
                return;
            }

            try
            {
                using (SqlConnection conn = new SqlConnection(GetConnectionString()))
                {
                    conn.Open();
                    // Still Inside = has a checkIn on a date with no matching checkOut on the same date.
                    // EventType stores 'checkIn' / 'checkOut' — this is the real direction field.
                    string query = @"
                        SELECT TOP 50
                            ci.Id                                           AS Id,
                            ISNULL(e.EmployeeCode, 'Unknown')               AS EmployeeID,
                            ci.PersonName                                   AS Name,
                            ci.SiteId                                       AS SiteID,
                            CONVERT(DATE, ci.Timestamp)                     AS WorkDate,
                            ci.Timestamp                                    AS ClockInTime,
                            DATEDIFF(MINUTE, ci.Timestamp, GETDATE())       AS MinutesInside
                        FROM ReaderEvents ci
                        LEFT JOIN Employees e
                            ON  e.NameSurname = ci.PersonName
                            AND CAST(e.SiteID AS NVARCHAR(MAX)) = CAST(ci.SiteId AS NVARCHAR(MAX))
                        WHERE ci.SiteId        = @SiteID
                          AND ci.PersonName    = @EmpName
                          AND ci.EventType     = 'checkIn'
                          AND ci.Timestamp    >= DATEADD(day, -30, GETDATE())
                          AND NOT EXISTS (
                              SELECT 1 FROM ReaderEvents co
                              WHERE co.PersonName = ci.PersonName
                                AND co.SiteId     = ci.SiteId
                                AND co.EventType  = 'checkOut'
                                AND CONVERT(DATE, co.Timestamp) = CONVERT(DATE, ci.Timestamp)
                          )
                        ORDER BY ci.Timestamp DESC
                    ";
                    
                    using (SqlCommand cmd = new SqlCommand(query, conn))
                    {
                        cmd.CommandTimeout = 30;
                        cmd.Parameters.AddWithValue("@SiteID", siteId);
                        cmd.Parameters.AddWithValue("@EmpName", empName);
                        
                        using (SqlDataAdapter da = new SqlDataAdapter(cmd))
                        {
                            DataTable dt = new DataTable();
                            da.Fill(dt);
                            gvIncomplete.DataSource = dt;
                            gvIncomplete.DataBind();
                        }
                    }
                }
                ShowMessage("Entries loaded.", true);
            }
            catch (Exception ex)
            {
                ShowMessage("Error loading data: " + ex.Message, false);
                gvIncomplete.DataSource = null;
                gvIncomplete.DataBind();
            }
        }

        protected void gvIncomplete_RowCommand(object sender, GridViewCommandEventArgs e)
        {
            if (e.CommandName == "CompleteEntry")
            {
                hfActivePanel.Value = "panelFind";
                int index = Convert.ToInt32(e.CommandArgument);
                GridViewRow row = gvIncomplete.Rows[index];
                TextBox txtClockOut = (TextBox)row.FindControl("txtClockOut");

                if (txtClockOut == null || string.IsNullOrEmpty(txtClockOut.Text))
                {
                    ShowMessage("Please provide a clock out time.", false);
                    return;
                }

                DateTime outTime;
                if (!DateTime.TryParse(txtClockOut.Text, CultureInfo.InvariantCulture, DateTimeStyles.None, out outTime))
                {
                    ShowMessage("Invalid date/time format for clock out.", false);
                    return;
                }

                // Read person and site from the bound cells (0=Id hidden, 1=EmployeeID, 2=Name, 3=SiteID)
                string personName = row.Cells[2].Text;
                string siteId     = row.Cells[3].Text;

                // Retrieve the clock-in time from ClockInTime cell to validate ordering
                DateTime clockInTime;
                string clockInRaw = ((System.Web.UI.WebControls.Label)row.FindControl("lblClockInTime") != null)
                    ? ((System.Web.UI.WebControls.Label)row.FindControl("lblClockInTime")).Text
                    : row.Cells[5].Text; // ClockInTime is cell index 5 (0=Id,1=EmpID,2=Name,3=SiteID,4=WorkDate,5=ClockInTime)

                if (DateTime.TryParse(clockInRaw, out clockInTime) && outTime <= clockInTime)
                {
                    ShowMessage("Clock out time must be after the clock in time (" + clockInTime.ToString("yyyy-MM-dd HH:mm") + ").", false);
                    return;
                }

                if (outTime > DateTime.Now)
                {
                    ShowMessage("Clock out time cannot be in the future.", false);
                    return;
                }

                try
                {
                    using (SqlConnection conn = new SqlConnection(GetConnectionString()))
                    {
                        conn.Open();
                        // Insert a checkOut event to pair with the existing checkIn.
                        // ReaderId is NOT NULL so we use 'ADMIN' to mark it as manually inserted.
                        // PayloadRaw (nvarchar MAX, nullable) stores the admin audit note.
                        string query = @"INSERT INTO ReaderEvents (PersonName, Timestamp, EventType, ReaderId, IsEmulated, SiteId, PayloadRaw)
                                         VALUES (@PersonName, @OutTime, 'checkOut', 'ADMIN', 1, @SiteId, @PayloadRaw)";
                        using (SqlCommand cmd = new SqlCommand(query, conn))
                        {
                            cmd.Parameters.AddWithValue("@PersonName", personName);
                            cmd.Parameters.AddWithValue("@OutTime",    outTime);
                            cmd.Parameters.AddWithValue("@SiteId",     siteId);
                            cmd.Parameters.AddWithValue("@PayloadRaw", "Admin manual checkOut");
                            cmd.ExecuteNonQuery();
                        }
                    }

                    ShowMessage(string.Format("Clock out saved for {0} at {1:yyyy-MM-dd HH:mm}.", personName, outTime), true);
                    LoadIncompleteEntries();
                }
                catch (Exception ex)
                {
                    ShowMessage("Error saving entry: " + ex.Message, false);
                }
            }
        }

        protected void btnManualEntry_Click(object sender, EventArgs e)
        {
            string siteId    = ddlManualSite.SelectedValue;
            string empID     = ddlManualEmployee.SelectedValue;
            string timestamp = txtManualTime.Text.Trim();
            string eventType = ddlEventType.SelectedValue;
            string reason    = txtReason.Text.Trim();

            if (string.IsNullOrEmpty(siteId))
            {
                ShowMessage("Please select a site in the Manual Scan Entry panel.", false);
                return;
            }

            if (string.IsNullOrEmpty(empID))
            {
                ShowMessage("Please select an employee in the Manual Scan Entry panel.", false);
                return;
            }

            if (string.IsNullOrEmpty(timestamp))
            {
                ShowMessage("Date/Time is required.", false);
                return;
            }

            DateTime parsedTime;
            if (!DateTime.TryParse(timestamp, CultureInfo.InvariantCulture, DateTimeStyles.None, out parsedTime))
            {
                ShowMessage("Invalid date/time format. Please use a valid date and time.", false);
                return;
            }

            if (parsedTime > DateTime.Now)
            {
                ShowMessage("Cannot create a clock entry in the future.", false);
                return;
            }

            if (reason.Length > 500)
            {
                reason = reason.Substring(0, 500);
            }

            try
            {
                using (SqlConnection conn = new SqlConnection(GetConnectionString()))
                {
                    conn.Open();
                    // Insert a scan event with the correct EventType.
                    // ReaderId is NOT NULL — use 'ADMIN' to identify manually inserted rows.
                    // Reason is stored in PayloadRaw (nvarchar MAX, nullable).
                    string query = @"INSERT INTO ReaderEvents (PersonName, Timestamp, EventType, ReaderId, IsEmulated, SiteId, PayloadRaw)
                                     VALUES (@PersonName, @Timestamp, @EventType, 'ADMIN', 1, @SiteId, @PayloadRaw)";
                    using (SqlCommand cmd = new SqlCommand(query, conn))
                    {
                        cmd.Parameters.AddWithValue("@PersonName", empID);
                        cmd.Parameters.AddWithValue("@SiteId",     siteId);
                        cmd.Parameters.AddWithValue("@Timestamp",  parsedTime);
                        cmd.Parameters.AddWithValue("@EventType",  eventType);
                        cmd.Parameters.AddWithValue("@PayloadRaw", string.IsNullOrEmpty(reason) ? "Admin manual entry" : reason);
                        cmd.ExecuteNonQuery();
                    }
                }

                ShowMessage(string.Format("Manual {0} saved for {1} at {2:yyyy-MM-dd HH:mm}.", eventType, empID, parsedTime), true);
                txtManualTime.Text = "";
                txtReason.Text = "";
                LoadIncompleteEntries();
            }
            catch (Exception ex)
            {
                ShowMessage("Error saving manual entry: " + ex.Message, false);
            }
        }

        private void ShowMessage(string message, bool isSuccess)
        {
            lblMessage.Text    = message;
            lblMessage.Visible = true;
            lblMessage.CssClass = isSuccess ? "alert alert-success" : "alert alert-error";

            // Also fire the system-wide toast so the admin sees a clean popup
            if (isSuccess)
                SohTnaNotify.Success(this, "Success", message);
            else
                SohTnaNotify.Error(this, "Error", message);
        }
