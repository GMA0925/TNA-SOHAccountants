-- ============================================================================
-- ADD SiteId TO ALL SETTINGS TABLES
-- Purpose: Scope all system settings per site so each site has its own
--          configuration that is applied when users from that site log in.
-- Safe to run multiple times (all changes are guarded with IF NOT EXISTS).
-- ============================================================================

PRINT '=== ADD SiteId TO SETTINGS TABLES ==='
PRINT ''

BEGIN TRANSACTION

-- ?????????????????????????????????????????????????????????????????????????????
-- 1. SystemSettings  (key/value store)
-- ?????????????????????????????????????????????????????????????????????????????
IF NOT EXISTS (
    SELECT 1 FROM INFORMATION_SCHEMA.COLUMNS
    WHERE TABLE_NAME = 'SystemSettings' AND COLUMN_NAME = 'SiteId'
)
BEGIN
    ALTER TABLE SystemSettings ADD SiteId NVARCHAR(MAX) NULL;
    PRINT '  + Added SiteId to SystemSettings';

    -- Default existing rows to a sentinel value so they become the global fallback
    UPDATE SystemSettings SET SiteId = 'DEFAULT' WHERE SiteId IS NULL;
    PRINT '  + Defaulted existing SystemSettings rows to SiteId = DEFAULT';
END
ELSE
    PRINT '  ~ SiteId already exists in SystemSettings';

-- ?????????????????????????????????????????????????????????????????????????????
-- 2. EmailConfiguration
-- ?????????????????????????????????????????????????????????????????????????????
