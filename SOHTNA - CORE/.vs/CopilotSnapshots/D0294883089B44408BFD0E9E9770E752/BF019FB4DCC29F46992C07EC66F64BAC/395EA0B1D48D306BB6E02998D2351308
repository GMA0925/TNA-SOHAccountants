-- ?????????????????????????????????????????????????????????????????????????????
-- 8. SiteSettingsCache  (NEW) — holds the flat key/value settings loaded into
--    the user session at login so they can be read without a DB hit each time.
--    This table is populated / updated every time an Admin saves settings.
-- ?????????????????????????????????????????????????????????????????????????????
IF NOT EXISTS (SELECT 1 FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME = 'SiteSettingsCache')
BEGIN
    CREATE TABLE SiteSettingsCache (
        CacheID       INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
        SiteId        NVARCHAR(MAX)     NOT NULL,
        SettingKey    NVARCHAR(100)     NOT NULL,
        SettingValue  NVARCHAR(MAX)     NULL,
        LastUpdated   DATETIME          NOT NULL DEFAULT GETDATE()
    );
    CREATE INDEX IX_SiteSettingsCache_SiteId ON SiteSettingsCache (SiteId);
    PRINT '  + Created SiteSettingsCache table';
END
ELSE
    PRINT '  ~ SiteSettingsCache already exists';

PRINT ''
PRINT '=== MIGRATION COMPLETE ==='
PRINT ''
PRINT 'NOTE: Existing rows have been assigned SiteId = DEFAULT.'
PRINT 'When an Admin belonging to a specific site first saves settings,'
PRINT 'those settings will be written with their real SiteId.'
PRINT 'The app falls back to DEFAULT rows when no site-specific row exists.'

COMMIT TRANSACTION
